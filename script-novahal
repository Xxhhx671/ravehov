        if GetRole(LocalPlayer) ~= "Sheriff" then Notify("TORIUM", "Not sheriff."); return end
        local g = mc:FindFirstChild("Gun")
        if not g and LocalPlayer.Backpack then
            g = LocalPlayer.Backpack:FindFirstChild("Gun")
            if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
        end
        if not g then Notify("TORIUM", "No gun."); return end
