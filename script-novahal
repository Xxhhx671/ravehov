local function DoSilentAim()
    local mc = GetMyChar(); if not mc then return end
    local r = GetRole(LocalPlayer)
    if r == "Sheriff" then
        local g = mc:FindFirstChild("Gun")
        if not g and LocalPlayer.Backpack then
            g = LocalPlayer.Backpack:FindFirstChild("Gun")
            if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
        end
        if g then
            local t = GetMurderer() or GetSheriffNotMe()
            if t then
                local p = PredictedPos(t, State.ShootOffset)
                if p and mc:FindFirstChild("RightHand") then
                    pcall(function() g.Shoot:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                end
            end
        end
    elseif r == "Murderer" then
        local k = mc:FindFirstChild("Knife")
        if not k and LocalPlayer.Backpack then
            k = LocalPlayer.Backpack:FindFirstChild("Knife")
            if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
        end
        if k then
            local nr, mD = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
                    local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
                    if d < mD then mD = d; nr = p end
                end
            end
            if nr then
                local p = PredictedPos(nr, State.ShootOffset + 1)
                if p and mc:FindFirstChild("RightHand") then
                    pcall(function() k.Events.KnifeThrown:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                end
            end
        end
    end
end

local function ShootMurderer()
    local mc = GetMyChar(); if not mc then Notify("TORIUM", "No character."); return end
    if GetRole(LocalPlayer) ~= "Sheriff" then Notify("TORIUM", "Not sheriff."); return end
