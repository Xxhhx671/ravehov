-- ── Auto-fly toward nearest target ─────────────────────────
local function flyToward(target, speed)
    local char  = lp.Character
    if not char then return end
    local hrp   = char:FindFirstChild("HumanoidRootPart")
    local tHRP  = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not tHRP then return end
    local dir = (tHRP.Position - hrp.Position).Unit
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end  -- disable default movement while flying
    hrp.CFrame = hrp.CFrame + dir * (speed or 50) * 0.016
end

local function getNearestByRole(filterRole)
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local role = getRole(p)
                if not filterRole or role == filterRole then
                    local d = (hrp.Position - myHRP.Position).Magnitude
                    if d < bestD then best, bestD = p, d end
                end
            end
        end
    end
    return best
end

-- ══════════════════════════════════════════════════════════════
--  MAIN RENDER LOOP
-- ══════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local myRole = getRole(lp)
    local roleC  = roleColor[myRole] or T.TextPrim

    -- Update role display
    roleLbl.Text       = "  Role: " .. myRole
    roleLbl.TextColor3 = roleC
    playerCountLbl.Text = "  Players in server: " .. #Players:GetPlayers()

    -- ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end

        local e = espPool[player]
        if not e then buildESP(player); e = espPool[player] end
        if not e then continue end

        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hrp and hum and hum.Health > 0

        if CFG.ESP.Enabled and alive then
            local role  = getRole(player)
            local color = roleColor[role] or T.Green

            -- billboard adornee
            e.billboard.Adornee = hrp
            e.billboard.Enabled = true

            e.nameL.TextColor3  = color
            e.roleL.Text        = "[" .. role .. "]"
            e.roleL.TextColor3  = color

            -- distance
            local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local dist  = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0

            e.distL.Visible = CFG.ESP.Distance
            if CFG.ESP.Distance then
                e.distL.Text = dist .. " studs"
            end

            -- weapon
            e.weapL.Visible = CFG.ESP.Weapon
            if CFG.ESP.Weapon then
                local w = getWeapon(player)
                e.weapL.Text = w and ("⚔ " .. w) or ""
            end

            -- health bar
            e.hbBB.Adornee = hrp
            e.hbBB.Enabled = CFG.ESP.HealthBar
            if CFG.ESP.HealthBar then
                local pct = hum.Health / hum.MaxHealth
                e.hbFill.Size = UDim2.new(1,0, pct, 0)
                local hpC = Color3.fromRGB(
                    math.floor((1-pct)*220),
                    math.floor(pct*200),
                    40
                )
                e.hbFill.BackgroundColor3 = hpC
            end

            -- glow (Highlight)
            e.glow.Enabled   = CFG.ESP.Glow
            e.glow.Adornee   = char
            e.glow.FillColor = color
            e.glow.OutlineColor = color

            -- box
            if CFG.ESP.Box then
                updateBox(player, e, color)
            else
                e.boxFrame.Visible = false
            end
        else
            e.billboard.Enabled = false
            e.hbBB.Enabled      = false
            e.glow.Enabled      = false
            e.boxFrame.Visible  = false
        end
    end

    -- Noclip + auto-fly (murderer)
    if CFG.Noclip.Enabled then
        if myRole == "Murder" then
            local target = getNearestByRole("Innocent") or getNearestByRole("Sheriff")
            if target then flyToward(target, 50) end
        else
            CFG.Noclip.Enabled = false
        end
    else
        -- restore platformstand
        local char = lp.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end

    -- Auto-aim (sheriff)
    if CFG.AutoAim.Enabled and myRole == "Sheriff" then
        local target = getNearestByRole("Murder")
        if target then
            local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if thrp then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, thrp.Position)
            end
        end
    end
end)

