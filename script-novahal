    CORE.PushToast = function(title, text, color, duration)
        if not State.ToastEnabled then return end
        color = color or ACCENT; duration = duration or 3
        while #CORE.ActiveToasts >= 6 do
            local old = table.remove(CORE.ActiveToasts, 1)
            if old then pcall(function() old:Destroy() end) end
        end
