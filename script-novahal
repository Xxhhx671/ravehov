local function BuildTabObj(pd)
    local o = pd
    function o:Next()
        self.ItemCount = self.ItemCount + 1
        return (self.ItemCount % 2 == 1) and self.Left or self.Right
    end
    function o:AddToggle(text, def, cb)
        local t = self:Next()
        local st = def or false
        local c = Instance.new("Frame")
        c.Size = UDim2.new(1,-6,0,38)
        c.BackgroundColor3 = PANEL_BG
        c.BackgroundTransparency = 0.15
        c.BorderSizePixel = 0
        c.Parent = t
        Instance.new("UICorner", c).CornerRadius = UDim.new(0,6)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-50,1,0)
        l.Position = UDim2.new(0,12,0,0)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = TEXT_MAIN
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 10.5
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextTruncate = Enum.TextTruncate.AtEnd
        l.Parent = c
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0,32,0,18)
        b.Position = UDim2.new(1,-42,0.5,-9)
        b.BackgroundColor3 = st and ACCENT_PRIMARY or Color3.fromRGB(45,36,65)
        b.Text = ""
        b.Parent = c
        Instance.new("UICorner", b).CornerRadius = UDim.new(1,0)
        local ci = Instance.new("Frame")
        ci.Size = UDim2.new(0,12,0,12)
        ci.Position = st and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
        ci.BackgroundColor3 = Color3.fromRGB(255,255,255)
        ci.Parent = b
        Instance.new("UICorner", ci).CornerRadius = UDim.new(1,0)
        b.MouseButton1Click:Connect(function()
            PlayClickSound()
            st = not st
            TweenService:Create(b, SMOOTH_TWEEN, {BackgroundColor3 = st and ACCENT_PRIMARY or Color3.fromRGB(45,36,65)}):Play()
            TweenService:Create(ci, SMOOTH_TWEEN, {Position = st and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
            if cb then task.spawn(cb, st) end
        end)
        table.insert(AllUIElements, {Text=text, Frame=c, PageObj=self})
    end
    function o:AddSlider(text, mn, mx, def, cb)
        local t = self:Next()
        local v = math.clamp(def or mn, mn, mx)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1,-6,0,46)
        f.BackgroundColor3 = PANEL_BG
        f.BackgroundTransparency = 0.15
        f.BorderSizePixel = 0
        f.Parent = t
        Instance.new("UICorner", f).CornerRadius = UDim.new(0,6)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(0.7,0,0,18)
        l.Position = UDim2.new(0,12,0,5)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = TEXT_MAIN
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 10.5
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f
        local vl = Instance.new("TextLabel")
        vl.Size = UDim2.new(0.3,-12,0,18)
        vl.Position = UDim2.new(0.7,0,0,5)
        vl.BackgroundTransparency = 1
        vl.Text = tostring(v)
        vl.TextColor3 = ACCENT_PRIMARY
        vl.Font = Enum.Font.GothamBold
        vl.TextSize = 10.5
        vl.TextXAlignment = Enum.TextXAlignment.Right
        vl.Parent = f
        local tr = Instance.new("Frame")
        tr.Size = UDim2.new(1,-24,0,5)
        tr.Position = UDim2.new(0,12,1,-14)
        tr.BackgroundColor3 = Color3.fromRGB(38,28,58)
        tr.BorderSizePixel = 0
        tr.Parent = f
        Instance.new("UICorner", tr).CornerRadius = UDim.new(1,0)
        local fi = Instance.new("Frame")
        fi.Size = UDim2.new((v-mn)/(mx-mn),0,1,0)
        fi.BackgroundColor3 = ACCENT_PRIMARY
        fi.BorderSizePixel = 0
        fi.Parent = tr
        Instance.new("UICorner", fi).CornerRadius = UDim.new(1,0)
        local tg = Instance.new("TextButton")
        tg.Size = UDim2.new(1,0,1,0)
        tg.BackgroundTransparency = 1
        tg.Text = ""
        tg.Parent = f
        local ds = false
        local function upd(i)
            local pc = math.clamp((i.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
            v = math.floor(mn + (mx - mn) * pc)
            vl.Text = tostring(v)
            fi.Size = UDim2.new(pc,0,1,0)
            if cb then task.spawn(cb, v) end
        end
        tg.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                PlayClickSound(); ds = true; upd(i)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if ds and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then ds = false end
        end)
        table.insert(AllUIElements, {Text=text, Frame=f, PageObj=self})
    end
    function o:AddButton(text, cb)
        local t = self:Next()
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1,-6,0,34)
        f.BackgroundColor3 = PANEL_BG
        f.BackgroundTransparency = 0.15
        f.BorderSizePixel = 0
        f.Parent = t
        Instance.new("UICorner", f).CornerRadius = UDim.new(0,6)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1,0,1,0)
        b.BackgroundTransparency = 1
        b.Text = text
        b.TextColor3 = TEXT_MAIN
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 10.5
        b.Parent = f
        b.MouseButton1Click:Connect(function()
            PlayClickSound()
            TweenService:Create(f, TweenInfo.new(0.08), {BackgroundColor3 = ACCENT_PRIMARY}):Play()
            task.wait(0.08)
            TweenService:Create(f, SMOOTH_TWEEN, {BackgroundColor3 = PANEL_BG}):Play()
            if cb then task.spawn(cb, b) end
        end)
        table.insert(AllUIElements, {Text=text, Frame=f, PageObj=self})
        return b
    end
    function o:AddText(text)
        local t = self:Next()
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1,-6,0,26)
        f.BackgroundColor3 = PANEL_BG
        f.BackgroundTransparency = 0.4
        f.BorderSizePixel = 0
        f.Parent = t
        Instance.new("UICorner", f).CornerRadius = UDim.new(0,6)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-16,1,0)
        l.Position = UDim2.new(0,8,0,0)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = TEXT_SUB
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 10
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f
    end
    return o
end

local function HideAllPages()
    for _, t in ipairs(TabsList) do
        TweenService:Create(t.Btn, SMOOTH_TWEEN, {TextColor3 = TEXT_SUB}):Play()
        for _, s in ipairs(t.SubTabs) do
            s.Page.Visible = false
            TweenService:Create(s.Btn, SMOOTH_TWEEN, {TextColor3 = TEXT_SUB}):Play()
            if s.Indicator then s.Indicator.Visible = false end
        end
    end
end

