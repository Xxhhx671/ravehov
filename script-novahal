-- Toggle row: returns toggle button so caller can wire it
local function makeToggle(labelText, order, configTable, configKey, onChanged)
    local row = Instance.new("Frame", scroll)
    row.Size            = UDim2.new(1, -16, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(14, 18, 26)
    row.BorderSizePixel = 0
    row.LayoutOrder     = order
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size            = UDim2.new(1, -60, 1, 0)
    lbl.Position        = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text            = labelText
    lbl.TextColor3      = Color3.fromRGB(200, 210, 230)
    lbl.Font            = Enum.Font.Gotham
    lbl.TextSize        = 13
    lbl.TextXAlignment  = Enum.TextXAlignment.Left

    -- Toggle pill
    local pill = Instance.new("Frame", row)
    pill.Size           = UDim2.new(0, 42, 0, 22)
    pill.Position       = UDim2.new(1, -54, 0.5, -11)
    pill.BackgroundColor3 = Color3.fromRGB(30, 35, 50)
    pill.BorderSizePixel = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", pill)
    knob.Size           = UDim2.new(0, 18, 0, 18)
    knob.Position       = UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(120, 130, 150)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function refresh()
        local on = configTable[configKey]
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on and UDim2.new(0, 22, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
            BackgroundColor3 = on and Color3.fromRGB(50, 130, 230) or Color3.fromRGB(120, 130, 150),
        }):Play()
        TweenService:Create(pill, TweenInfo.new(0.15), {
            BackgroundColor3 = on and Color3.fromRGB(20, 50, 100) or Color3.fromRGB(30, 35, 50),
        }):Play()
    end

    refresh()

    -- Works for both Touch and MouseButton1
    local btn = Instance.new("TextButton", row)
    btn.Size            = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text            = ""
    btn.ZIndex          = 5
    btn.MouseButton1Click:Connect(function()
        configTable[configKey] = not configTable[configKey]
        refresh()
        if onChanged then onChanged(configTable[configKey]) end
    end)

    return row
end

