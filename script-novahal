local currentFPS, currentPing = 60, 0
local frameCount, lastFpsCheck = 0, tick()

local fpsConn = RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastFpsCheck >= 0.5 then
        currentFPS  = math.floor(frameCount / (now - lastFpsCheck))
        frameCount  = 0
        lastFpsCheck = now
        pcall(function()
            currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
    end
end)
table.insert(activeCleanups, function() fpsConn:Disconnect() end)

