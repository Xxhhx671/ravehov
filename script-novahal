local function FlingPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local myChar = GetMyChar()
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local hrp = hum and hum.RootPart
    if not hrp then return end
    local tchar = targetPlayer.Character
    local thum = tchar:FindFirstChildOfClass("Humanoid")
    local thrp = thum and thum.RootPart
    local thead = tchar:FindFirstChild("Head")
    if not thum then return end
    local oldFallen = workspace.FallenPartsDestroyHeight
    local oldPos = hrp.CFrame
    local BV = Instance.new("BodyVelocity")
    BV.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
    BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BV.Parent = hrp
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    local function FPos(part, pos, ang)
        hrp.CFrame = CFrame.new(part.Position) * pos * ang
        myChar:SetPrimaryPartCFrame(CFrame.new(part.Position) * pos * ang)
        hrp.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        hrp.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end
    local function SFP(part)
        local t0 = tick()
        local angle = 0
        repeat
            if not hrp or not thum then break end
            angle = angle + 100
            FPos(part, CFrame.new(0, 1.5, 0) + thum.MoveDirection * 3, CFrame.Angles(math.rad(angle), 0, 0))
            task.wait()
            FPos(part, CFrame.new(0, -1.5, 0) + thum.MoveDirection * 3, CFrame.Angles(math.rad(angle), 0, 0))
            task.wait()
        until part.Velocity.Magnitude > 500 or tick() > t0 + 2
    end
    workspace.FallenPartsDestroyHeight = 0/0
    if thrp and thead and (thrp.CFrame.p - thead.CFrame.p).Magnitude > 5 then
        SFP(thead)
    elseif thrp then
        SFP(thrp)
    end
    BV:Destroy()
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.FallenPartsDestroyHeight = oldFallen
    pcall(function()
        repeat
            hrp.CFrame = oldPos
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.wait()
        until (hrp.Position - oldPos.p).Magnitude < 25
    end)
end

