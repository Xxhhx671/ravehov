                b.MouseButton1Click:Connect(function()
                    Click()
                    st = not st
                    TweenService:Create(b, TWEEN, {BackgroundColor3 = st and ACCENT or Color3.fromRGB(45,36,65)}):Play()
                    TweenService:Create(ci, TWEEN, {Position = st and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
                    NotifyToggle(text, st)
                    if cb then task.spawn(cb, st) end
                end)
                return b, l
            end
            function o:AddSlider(text, mn, mx, def, cb)
                local t = self:Next()
                local v = math.clamp(def or mn, mn, mx)
                local f = Instance.new("Frame")
                f.Size = UDim2.new(1,-6,0,46); f.BackgroundColor3 = PANEL_BG
                f.BackgroundTransparency = 0.15; f.BorderSizePixel = 0; f.Parent = t
                Instance.new("UICorner", f).CornerRadius = UDim.new(0,6)
                local l = Instance.new("TextLabel")
