end

local function KnifeThrow(silent)
    local mc = GetMyChar()
    if not mc then return end
    if GetPlayerRole(LocalPlayer) ~= "Murderer" then
        if not silent then SendNotify("TORIUM","Not murderer.") end
        return
    end
    local k = mc:FindFirstChild("Knife")
    if not k and LocalPlayer.Backpack then
        k = LocalPlayer.Backpack:FindFirstChild("Knife")
        if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
    end
    if not k then return end
    local nr, mD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
            if d < mD then mD = d; nr = p end
        end
    end
    if not nr then return end
    local p = GetPredictedPosition(nr, State.ShootOffset + 1)
    if not p then return end
    local s = CFrame.new(mc.RightHand.Position)
    if State.SpawnKnifeNear and nr.Character then
        local nh = nr.Character:FindFirstChild("HumanoidRootPart")
        if nh then s = CFrame.new(nh.Position + (nh.CFrame.LookVector * 5)) end
    end
    pcall(function() k.Events.KnifeThrown:FireServer(s, CFrame.new(p)) end)
end
