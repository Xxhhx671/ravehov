STEP("helpers", function()
    CORE.HasTool = function(plr, name)
        if not plr then return false end
        if plr.Backpack and plr.Backpack:FindFirstChild(name) then return true end
        if plr.Character and plr.Character:FindFirstChild(name) then return true end
        return false
    end
    CORE.GetRole = function(plr)
        if not plr or not plr.Character then return "Innocent" end
        if CORE.HasTool(plr, "Knife") then return "Murderer" end
        if CORE.HasTool(plr, "Gun") then return "Sheriff" end
        return "Innocent"
    end
    CORE.RoleColor = function(r)
        if r == "Murderer" then return State.ESP_Murderer_Color end
        if r == "Sheriff" then return State.ESP_Sheriff_Color end
        return State.ESP_Innocent_Color
    end
    CORE.GetMurderer = function()
        for _, p in ipairs(Players:GetPlayers()) do if CORE.GetRole(p) == "Murderer" then return p end end
    end
    CORE.GetSheriff = function()
        for _, p in ipairs(Players:GetPlayers()) do if CORE.GetRole(p) == "Sheriff" then return p end end
    end
    CORE.GetSheriffNotMe = function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and CORE.GetRole(p) == "Sheriff" then return p end
        end
    end
    CORE.GetMyChar = function() return LocalPlayer.Character end
    CORE.GetMyHRP = function() local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end
    CORE.GetMap = function()
        for _, o in ipairs(workspace:GetChildren()) do
            if o:FindFirstChild("CoinContainer") and o:FindFirstChild("Spawns") then return o end
        end
    end
    CORE.SameTeam = function(plr)
        if not plr or plr == LocalPlayer then return true end
        local ok1, t1 = pcall(function() return plr.Team end)
        local ok2, t2 = pcall(function() return LocalPlayer.Team end)
        if ok1 and ok2 and t1 and t2 then return t1 == t2 end
        return false
    end
    CORE.IsGun = function(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local n = tool.Name:lower()
        if n:find("gun") or n:find("pistol") or n:find("rifle") or n:find("smg")
           or n:find("shotgun") or n:find("sniper") or n:find("revolver") then return true end
        if tool:FindFirstChild("Shoot") or tool:FindFirstChild("Fire") then return true end
        return false
    end
    CORE.HasAnyGun = function(plr)
        if not plr then return false end
        local c = plr.Character
        if c then for _, t in ipairs(c:GetChildren()) do if CORE.IsGun(t) then return true end end end
        if plr.Backpack then for _, t in ipairs(plr.Backpack:GetChildren()) do if CORE.IsGun(t) then return true end end end
        return false
    end
    CORE.EquipAnyGun = function()
        local mc = CORE.GetMyChar(); if not mc then return nil end
        local hu = mc:FindFirstChildOfClass("Humanoid"); if not hu then return nil end
        for _, t in ipairs(mc:GetChildren()) do if CORE.IsGun(t) then return t end end
        if LocalPlayer.Backpack then
            for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if CORE.IsGun(t) then pcall(function() hu:EquipTool(t) end); return t end
            end
        end
        return nil
    end
    CORE.FireTool = function(tool, targetPart)
        if not tool or not targetPart then return false end
        local mc = CORE.GetMyChar(); if not mc then return false end
        local hand = mc:FindFirstChild("RightHand") or mc:FindFirstChild("Right Arm") or mc.PrimaryPart
        if not hand then return false end
        if tool:FindFirstChild("Shoot") and tool.Shoot:IsA("RemoteEvent") then
            pcall(function() tool.Shoot:FireServer(CFrame.new(hand.Position), CFrame.new(targetPart.Position)) end)
            return true
        end
        if tool:FindFirstChild("Fire") and tool.Fire:IsA("RemoteEvent") then
            pcall(function() tool.Fire:FireServer(CFrame.new(hand.Position), CFrame.new(targetPart.Position)) end)
            return true
        end
        for _, ch in ipairs(tool:GetDescendants()) do
            if ch:IsA("RemoteEvent") then
                local n = ch.Name:lower()
                if n:find("shoot") or n:find("fire") or n:find("attack") or n:find("hit") then
                    pcall(function() ch:FireServer(CFrame.new(hand.Position), CFrame.new(targetPart.Position)) end)
                    return true
                end
            end
        end
        pcall(function() tool:Activate() end)
        return true
    end
    CORE.ThrowKnife = function(knife, targetPart)
        if not knife or not targetPart then return false end
        local mc = CORE.GetMyChar(); if not mc then return false end
        local hand = mc:FindFirstChild("RightHand") or mc:FindFirstChild("Right Arm")
        if not hand then return false end
        local events = knife:FindFirstChild("Events")
        if events and events:FindFirstChild("KnifeThrown") then
            pcall(function() events.KnifeThrown:FireServer(CFrame.new(hand.Position), CFrame.new(targetPart.Position)) end)
            return true
        end
        for _, ch in ipairs(knife:GetDescendants()) do
            if ch:IsA("RemoteEvent") then
                local n = ch.Name:lower()
                if n:find("knife") or n:find("throw") or n:find("slash") then
                    pcall(function() ch:FireServer(CFrame.new(hand.Position), CFrame.new(targetPart.Position)) end)
                    return true
                end
            end
        end
        pcall(function() knife:Activate() end)
        return true
    end
    CORE.PredictedPos = function(target, offset)
        if not target or not target.Character then return nil end
        local c = target.Character
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local ut = c:FindFirstChild("UpperTorso") or hrp
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not ut or not hum or not CORE.GetMyHRP() then return nil end
        local v = ut.AssemblyLinearVelocity
        local md = hum.MoveDirection
        local p = ut.Position + v * Vector3.new(0.75,0.5,0.75) * (offset / 15) + md * offset
        local ping = LocalPlayer:GetNetworkPing() * 1000
        local mult = (ping * ((State.OffsetPingMult - 1) * 0.01)) + 1
        return p * mult
    end
end)

