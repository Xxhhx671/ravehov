-- Clone local character into viewport
local vpCamera = Instance.new("Camera", viewport)
viewport.CurrentCamera  = vpCamera

local function refreshViewport()
    -- clear old
    for _, c in ipairs(viewport:GetChildren()) do
        if c:IsA("Model") then c:Destroy() end
    end
    local char = lp.Character
    if not char then return end

    local clone = char:Clone()
    -- remove scripts so it doesn't run
    for _, s in ipairs(clone:GetDescendants()) do
        if s:IsA("Script") or s:IsA("LocalScript") then s:Destroy() end
    end
    clone.Parent = viewport

    local hrp = clone:FindFirstChild("HumanoidRootPart")
    if hrp then
        local cf = hrp.CFrame
        vpCamera.CFrame = CFrame.new(cf.Position + cf.LookVector * 0 + Vector3.new(0, 1.5, 5), cf.Position + Vector3.new(0, 1, 0))
        vpCamera.FieldOfView = 50
    end

    -- animate slow rotation
    local angle = 0
    local rotConn
    rotConn = RunService.RenderStepped:Connect(function(dt)
        if not viewport.Parent then rotConn:Disconnect() return end
        angle = angle + dt * 30
        local hrp2 = clone:FindFirstChild("HumanoidRootPart")
        if hrp2 then
            local pos = hrp2.Position + Vector3.new(0, 1, 0)
            local rad  = math.rad(angle)
            vpCamera.CFrame = CFrame.new(
                pos + Vector3.new(math.sin(rad)*5, 1.5, math.cos(rad)*5),
                pos
            )
        end
    end)
end

refreshViewport()
