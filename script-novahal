        pageData.Page.Visible = true
        TweenService:Create(parentTab.Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
        if parentTab.IconImg then TweenService:Create(parentTab.IconImg, SMOOTH_TWEEN, {ImageColor3 = ACCENT_PRIMARY}):Play() end
        TweenService:Create(subLbl, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
        if subIconImg then TweenService:Create(subIconImg, SMOOTH_TWEEN, {ImageColor3 = ACCENT_PRIMARY}):Play() end
        indicator.Visible = true
    end)

    return pageObj
end

