-- CONFIG SYSTEM (file-based with fallback to memory)
local function GetConfigKey()
    return "ToriumCfg_" .. tostring(LocalPlayer.UserId)
end
local function GetDeviceKey()
    local p = "PC"
    pcall(function()
        if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then p = "Mobile" end
    end)
    return "ToriumDevice_" .. p
end
local function HasFileAPI()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function SerializeState()
    local config = {}
    for k, v in pairs(State) do
        if typeof(v) == "Color3" then
            config[k] = {__t = "Color3", r = v.R, g = v.G, b = v.B}
        elseif type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
            config[k] = v
        end
    end
    return config
end

local function ApplyConfig(data)
    for k, v in pairs(data) do
        if type(v) == "table" and v.__t == "Color3" then
            State[k] = Color3.new(v.r, v.g, v.b)
        else
            State[k] = v
        end
    end
end

local function SaveConfig(slot)
    local json = HttpService:JSONEncode(SerializeState())
    if HasFileAPI() then
        pcall(function()
            if not isfolder("Torium") then makefolder("Torium") end
            writefile("Torium/" .. GetConfigKey() .. "_" .. slot .. ".json", json)
            writefile("Torium/" .. GetDeviceKey() .. "_" .. slot .. ".json", json)
        end)
    else
        getgenv().ToriumMemCfg = getgenv().ToriumMemCfg or {}
        getgenv().ToriumMemCfg[tostring(LocalPlayer.UserId) .. "_" .. slot] = json
    end
    SendNotify("Config", "Saved slot " .. slot)
end

local function LoadConfig(slot)
    local json
    if HasFileAPI() then
        pcall(function()
            local accPath = "Torium/" .. GetConfigKey() .. "_" .. slot .. ".json"
            local devPath = "Torium/" .. GetDeviceKey() .. "_" .. slot .. ".json"
            if isfile(accPath) then json = readfile(accPath)
            elseif isfile(devPath) then json = readfile(devPath) end
        end)
    else
        getgenv().ToriumMemCfg = getgenv().ToriumMemCfg or {}
        json = getgenv().ToriumMemCfg[tostring(LocalPlayer.UserId) .. "_" .. slot]
    end
    if not json then SendNotify("Config", "Slot " .. slot .. " empty") return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or not data then return false end
    ApplyConfig(data)
    SendNotify("Config", "Loaded slot " .. slot)
    return true
end

local function DeleteConfig(slot)
    if HasFileAPI() then
        pcall(function()
            if isfile("Torium/" .. GetConfigKey() .. "_" .. slot .. ".json") then
                delfile("Torium/" .. GetConfigKey() .. "_" .. slot .. ".json")
            end
        end)
    else
        getgenv().ToriumMemCfg = getgenv().ToriumMemCfg or {}
        getgenv().ToriumMemCfg[tostring(LocalPlayer.UserId) .. "_" .. slot] = nil
    end
    SendNotify("Config", "Deleted slot " .. slot)
end

local function SendNotify(t, x)
    pcall(function() StarterGui:SetCore("SendNotification", {Title=t, Text=x, Duration=4}) end)
end

