            ind.BackgroundColor3 = ACCENT; ind.BorderSizePixel = 0
            ind.Visible = false; ind.Parent = sb
            Instance.new("UICorner", ind).CornerRadius = UDim.new(1,0)
            local pd = CORE.CreatePage()
            local po = CORE.BuildTab(pd)
            local so = {Btn=sl, Page=pd.Page, PageObj=po, Indicator=ind}
            table.insert(pt.SubTabs, so)
            sb.MouseButton1Click:Connect(function()
