-- ═══════════════════════════════════════
-- ███  AIMBOT CORE (ИСПРАВЛЕНО)  ███
-- ═══════════════════════════════════════
-- Ключевые фиксы:
-- 1. BindToRenderStep с RenderPriority.Camera.Value + 1 — камера не перезаписывается
-- 2. Прямое изменение Camera.CFrame через CFrame.new(pos, lookAt) вместо lookAt lerp
-- 3. Правильное сглаживание через lerp factor с clamp
-- ═══════════════════════════════════════
local Aimbot = {Target=nil, Locked=nil, LastFire=0}

local function GetCam() return workspace.CurrentCamera end

local function W2S(pos)
    local cam = GetCam()
    if not cam then return Vector2.new(0,0), false end
    local sp, on = cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on
end

local function GetHitbox(plr)
    if not plr or not plr.Character then return nil end
    local hb = State.AimbotHitbox
    if hb == "Head" then return plr.Character:FindFirstChild("Head") end
    if hb == "HumanoidRootPart" then return plr.Character:FindFirstChild("HumanoidRootPart") end
    return plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")
end

local function HasLOS(plr)
    if State.AimbotWallbang or not State.AimbotVisibleCheck then return true end
    local mc = GetMyChar(); local hrp = GetMyHRP(); local hb = GetHitbox(plr)
    if not hrp or not hb then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {mc, plr.Character}
    return not workspace:Raycast(hrp.Position, hb.Position - hrp.Position, rp)
end

local function ValidTarget(plr)
    if plr == LocalPlayer or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return GetHitbox(plr) ~= nil
end

local function MatchTarget(plr)
    local want = State.AimbotTarget
    local role = GetRole(plr)
    local myRole = GetRole(LocalPlayer)
    if want == "Murderer" then
        if myRole == "Murderer" then return role ~= "Murderer" end
        return role == "Murderer" or (myRole == "Sheriff" and role ~= "Sheriff")
    end
    if want == "Sheriff" then return role == "Sheriff" end
    if want == "Innocent" then return role == "Innocent" end
    return true
end

local function SelectTarget()
    local best, bestDist = nil, math.huge
    local cam = GetCam(); if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if ValidTarget(plr) and MatchTarget(plr) and HasLOS(plr) then
            local hb = GetHitbox(plr)
            if hb then
                local sp, on = W2S(hb.Position)
                if on then
                    local d = (sp - center).Magnitude
                    if d <= State.AimbotFOV and d < bestDist then
                        best = plr; bestDist = d
                    end
                end
            end
        end
    end
    return best
end

local function PredictPos(plr)
    local hb = GetHitbox(plr)
    if not hb then return nil end
    if not State.AimbotPrediction then return hb.Position end
    local p = LocalPlayer:GetNetworkPing()
    return hb.Position + hb.AssemblyLinearVelocity * (p * 0.5)
end

-- ФИКС: применяем через CFrame.new(pos, target) с пересчётом каждый кадр
local function AimCamera(plr)
    local cam = GetCam()
    if not cam then return end
    local tp = PredictPos(plr)
    if not tp then return end
    local cp = cam.CFrame.Position
    local dir = tp - cp
    if dir.Magnitude < 0.001 then return end
    -- ФИКС: используем CFrame.lookAt и правильный lerp по quaternion через CFrame:Lerp
    local goal = CFrame.lookAt(cp, tp)
    if State.AimbotFlickMode then
        cam.CFrame = goal
    else
        -- Плавный lerp; при Smooth=1 мгновенно, при 0.05 медленно
        local s = math.clamp(State.AimbotSmooth, 0.05, 1)
        cam.CFrame = cam.CFrame:Lerp(goal, s)
    end
end

local lastHitNotify = 0
local function FireAt(plr)
    local mc = GetMyChar(); if not mc then return end
    local role = GetRole(LocalPlayer)
    local ok = false
    if role == "Sheriff" then
        local g = mc:FindFirstChild("Gun")
        if not g and LocalPlayer.Backpack then
            g = LocalPlayer.Backpack:FindFirstChild("Gun")
            if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
        end
        if g then
            local p = PredictPos(plr)
            if p and mc:FindFirstChild("RightHand") then
                pcall(function() g.Shoot:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                ok = true
            end
        end
    elseif role == "Murderer" then
        local k = mc:FindFirstChild("Knife")
        if not k and LocalPlayer.Backpack then
            k = LocalPlayer.Backpack:FindFirstChild("Knife")
            if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
        end
        if k then
            local p = PredictPos(plr)
            if p and mc:FindFirstChild("RightHand") then
                pcall(function() k.Events.KnifeThrown:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                ok = true
            end
        end
    end
    if ok and State.AimbotHeadshotNotify and tick() - lastHitNotify > 0.5 then
        lastHitNotify = tick()
        local hitName = State.AimbotHitbox
        PushToast("Hit " .. hitName, plr.Name .. " [" .. GetRole(plr) .. "]", Color3.fromRGB(34,197,94), 1.6)
        Hit()
    end
end

local function UpdateFOVCircle()
    if not State.AimbotDrawFOV or not State.Aimbot then FOVCircle.Visible = false; return end
    FOVCircle.Visible = true
    FOVStroke.Color = State.AimbotFOVColor
    local cam = GetCam(); if not cam then return end
    local screenY = cam.ViewportSize.Y
    local camFov = cam.FieldOfView
    local px = (math.tan(math.rad(State.AimbotFOV/2)) / math.tan(math.rad(camFov/2))) * (screenY/2)
    px = math.clamp(px, 20, screenY)
    FOVCircle.Size = UDim2.new(0, px*2, 0, px*2)
end

-- ФИКС: применяем через BindToRenderStep с приоритетом ПОСЛЕ обновления камеры
local BIND_NAME = "ToriumAimbotCamera"
local function AimbotRenderStep()
    if not State.Aimbot then
        Aimbot.Locked = nil
        FOVCircle.Visible = false
        return
    end
    UpdateFOVCircle()

    local t = SelectTarget()
    Aimbot.Target = t
    if t then
        Aimbot.Locked = t
    elseif Aimbot.Locked and not ValidTarget(Aimbot.Locked) then
        Aimbot.Locked = nil
    end

    local tg = Aimbot.Locked
    if tg and ValidTarget(tg) then
        AimCamera(tg)
        if State.AimbotAutoFire and tick() - Aimbot.LastFire > State.AimbotTriggerDelay then
            Aimbot.LastFire = tick()
            FireAt(tg)
        end
    end
end

local aimBound = false
local function StartAimbot()
    if not aimBound then
        aimBound = true
        pcall(function()
            RunService:UnbindFromRenderStep(BIND_NAME)
        end)
        RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, AimbotRenderStep)
    end
end
local function StopAimbot()
    if aimBound then
        pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
        aimBound = false
    end
end
table.insert(activeCleanups, function() pcall(StopAimbot) end)

