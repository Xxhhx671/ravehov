local mainConn = RunService.RenderStepped:Connect(function()
    if not workspace.CurrentCamera then return end
    if State.Fullbright then Lighting.Ambient = Color3.fromRGB(255, 255, 255) end
    if State.NoFog then Lighting.FogEnd = 9e9 end
    if State.CustomFogColor then Lighting.FogColor = State.FogColorVal end
    if State.ChaseCamera and State.ChaseTarget and State.ChaseTarget.Character then
        local hum = State.ChaseTarget.Character:FindFirstChildOfClass("Humanoid")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end
    if State.SilentAim then DoSilentAim() end
    if State.KillAura then StartKillAura() end
    if State.AutoGrabGun then AutoGrabGunTick() end
    if State.Bhop and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and UserInputService:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
    if State.AutoStrafe and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.FloorMaterial == Enum.Material.Air then
            local md = hum.MoveDirection
            if md.Magnitude > 0 then
                local v = hrp.AssemblyLinearVelocity
                local d = md * State.StrafeSpeed
                hrp.AssemblyLinearVelocity = Vector3.new(v.X + (d.X - v.X) * 0.25, v.Y, v.Z + (d.Z - v.Z) * 0.25)
            end
        end
    end
    if State.Spinbot and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local angle = (tick() * State.YawSpeed * 10) % 360
            if State.Jitter then angle = angle + math.random(-State.JitterIntensity * 5, State.JitterIntensity * 5) end
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(angle), 0)
        end
    end
    if State.LoopFlingMurderer then
        local m = GetMurderer()
        if m and m ~= LocalPlayer then
            task.spawn(FlingPlayer, m)
        end
    end
end)
table.insert(activeCleanups, function() mainConn:Disconnect() end)

