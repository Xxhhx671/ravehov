        task.wait(0.15)
        for _, h in ipairs(ac) do pcall(function() h.Anchored = false end) end
        Notify("TORIUM", "Kill everyone executed.")
    end

    CORE.StartKillAura = function()
        if not State.KillAura then return end
        local mc = GetMyChar(); if not mc then return end
        local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
