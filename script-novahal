local espPool = {}  -- [player] = { billboard, box, healthBar, glow }

local function removeESP(player)
    local e = espPool[player]
    if e then
        if e.billboard then e.billboard:Destroy() end
        if e.box       then e.box:Destroy() end
        if e.glow      then e.glow:Destroy() end
        espPool[player] = nil
    end
end

