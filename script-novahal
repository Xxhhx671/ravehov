-- ═══════════════════════════════════════════
-- PREDICTION
-- ═══════════════════════════════════════════
local function GetPredictedPosition(targetPlr, offset)
    if not targetPlr or not targetPlr.Character then return nil end
    local char = targetPlr.Character
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local ut   = char:FindFirstChild("UpperTorso") or hrp
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not ut or not hum then return nil end
    if not GetMyHRP() then return nil end
    local velocity = ut.AssemblyLinearVelocity
    local moveDir  = hum.MoveDirection
    local predicted = ut.Position
        + velocity * Vector3.new(0.75, 0.5, 0.75) * (offset / 15)
        + moveDir * offset
    local ping = LocalPlayer:GetNetworkPing() * 1000
    local mult = (ping * ((State.OffsetPingMult - 1) * 0.01)) + 1
    predicted = predicted * mult
    return predicted
end

