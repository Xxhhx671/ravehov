-- ============================================================
--  ROLE DETECTION
-- ============================================================
-- MM2 puts a Tool named "Knife" in murderer's Backpack/Character
-- and "Gun" for sheriff. Innocent has neither.
local function getMyRole()
    local char = lp.Character
    local bp   = lp.Backpack
    if not char then return "Innocent" end
    for _, v in ipairs({char, bp}) do
        for _, tool in ipairs(v:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("knife") then return "Murderer" end
                if n:find("gun")   then return "Sheriff"  end
            end
        end
    end
    return "Innocent"
end

local function getPlayerRole(player)
    local char = player.Character
    local bp   = player.Backpack
    if not char then return "Innocent" end
    for _, v in ipairs({char, bp}) do
        for _, tool in ipairs(v:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("knife") then return "Murderer" end
                if n:find("gun")   then return "Sheriff"  end
            end
        end
    end
    return "Innocent"
end

