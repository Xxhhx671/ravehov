-- ============================================================
--  MAIN LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    local myRole = getMyRole()

    -- Role indicator
    roleIndicator.Text       = "Role: " .. myRole
    roleIndicator.TextColor3 = roleColor[myRole] or Color3.new(1,1,1)

    -- ESP update
    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end

        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if CFG.ESP.Enabled and hrp and hum and hum.Health > 0 then
            local bb = espPool[player]
            if not bb then bb = createESP(player) end
            if bb then
                bb.Adornee = hrp
                bb.Enabled = true

                local role  = getPlayerRole(player)
                local color = roleColor[role] or Color3.new(1,1,1)

                local nameL = bb:FindFirstChild("NameL")
                local roleL = bb:FindFirstChild("RoleL")
                if nameL then
                    nameL.TextColor3 = color
                end
                if roleL then
                    roleL.Text       = "[" .. role .. "]"
                    roleL.TextColor3 = color
                end

                -- Distance cull
                local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    bb.Enabled = dist <= CFG.ESP.MaxDist
                end
            end
        else
            local bb = espPool[player]
            if bb then
                bb.Enabled = false
            end
        end
    end

    -- Noclip auto-fly toward nearest innocent (murderer logic)
    if CFG.Noclip.Enabled and myRole == "Murderer" then
        local target = getNearestTarget("Innocent") or getNearestTarget("Sheriff")
        if target then
            flyToward(target)
        end
    end

    -- Soft-aim toward murderer (sheriff logic)
    if CFG.AutoAim.Enabled and myRole == "Sheriff" then
        softAimAtMurderer()
    end

    -- Force-disable features if role doesn't match
    if myRole ~= "Murderer" and CFG.Noclip.Enabled then
        CFG.Noclip.Enabled = false
        setNoclip(false)
    end
    if myRole ~= "Sheriff" and CFG.AutoAim.Enabled then
        -- don't force disable — let user keep it enabled, just won't fire above
    end
end)

