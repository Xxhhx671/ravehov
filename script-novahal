                    bb.AlwaysOnTop = true
                    bb.Adornee = o
                    bb.Parent = ESP_GUI
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1,0,1,0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = isGunDrop and "Gun" or "Trap"
                    lbl.TextColor3 = hl.FillColor
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 11
                    lbl.Parent = bb
                    CORE.DROP_OBJ[o] = {hl=hl, bb=bb, lbl=lbl}
                end
            end
        end
        for k, e in pairs(CORE.DROP_OBJ) do
            if not seen[k] or not k.Parent then
                pcall(function() e.hl:Destroy() end)
                pcall(function() e.bb:Destroy() end)
                CORE.DROP_OBJ[k] = nil
            end
        end
    end
    task.spawn(function()
        while task.wait(0.3) do
            if State.GunDropESP or State.TrapESP then CORE.TickDropESP() else CORE.RemoveDropESP() end
        end
    end)
end)

