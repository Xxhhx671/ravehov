local function OpenAKMenu()
    if not AKMenuGui then CreateAKMenu() end
    if not AKMenuGui then return end
    local ctr = AKMenuGui:FindFirstChild("Center")
    local ov = AKMenuGui:FindFirstChild("Overlay")
    local eb = AKMenuGui:FindFirstChild("Execute")
    local cb = AKMenuGui:FindFirstChild("Cancel")
    if AKMenuOpen then
        AKMenuOpen = false
        if ctr then TweenService:Create(ctr, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0,0,0,0), Rotation = -360}):Play() end
        if ov then TweenService:Create(ov, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play() end
        if eb then TweenService:Create(eb, TweenInfo.new(0.3), {BackgroundTransparency = 1, TextTransparency = 1}):Play() end
        if cb then TweenService:Create(cb, TweenInfo.new(0.3), {BackgroundTransparency = 1, TextTransparency = 1}):Play() end
        task.delay(0.55, function()
            if AKMenuGui then AKMenuGui.Enabled = false end
            if ctr then ctr.Size = UDim2.new(0,240,0,240) ctr.Rotation = 0 end
            if eb then eb.BackgroundTransparency = 0 eb.TextTransparency = 0 end
            if cb then cb.BackgroundTransparency = 0.2 cb.TextTransparency = 0 end
        end)
        return
    end
    AKMenuOpen = true
    AKMenuGui.Enabled = true
    local st = ctr and ctr:FindFirstChild("Status")
    if st then st.Text = "" end
    if ctr then
        ctr.Size = UDim2.new(0,0,0,0)
        ctr.Rotation = 0
        TweenService:Create(ctr, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0,240,0,240), Rotation = 360
        }):Play()
        task.delay(0.7, function() if ctr and AKMenuOpen then ctr.Rotation = 0 end end)
    end
    if ov then
        ov.BackgroundTransparency = 1
        TweenService:Create(ov, TweenInfo.new(0.5), {BackgroundTransparency = 0.5}):Play()
    end
    if eb then
        eb.BackgroundTransparency = 1
        eb.TextTransparency = 1
        TweenService:Create(eb, TweenInfo.new(0.4), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    end
    if cb then
        cb.BackgroundTransparency = 1
        cb.TextTransparency = 1
        TweenService:Create(cb, TweenInfo.new(0.4), {BackgroundTransparency = 0.2, TextTransparency = 0}):Play()
    end
end

