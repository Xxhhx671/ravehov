-- MAIN RENDER LOOP
-- ═══════════════════════════════════════════
local mainRenderConn = RunService.RenderStepped:Connect(function()
    -- Camera safety
    if not workspace.CurrentCamera then return end

    if State.Fullbright then Lighting.Ambient = Color3.fromRGB(255, 255, 255) end
    if State.NoFog then Lighting.FogEnd = 9e9 end
    if State.CustomFogColor then Lighting.FogColor = State.FogColorVal end

    -- Bhop
    if State.Bhop and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and UserInputService:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    -- Auto Strafe
    if State.AutoStrafe and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.FloorMaterial == Enum.Material.Air then
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                local v = hrp.AssemblyLinearVelocity
                local d = moveDir * State.StrafeSpeed
                hrp.AssemblyLinearVelocity = Vector3.new(
                    v.X + (d.X - v.X) * 0.25,
                    v.Y,
                    v.Z + (d.Z - v.Z) * 0.25
                )
            end
        end
    end

    -- Spinbot
    if State.Spinbot and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local angle = (tick() * State.YawSpeed * 10) % 360
            if State.Jitter then
                angle = angle + math.random(-State.JitterIntensity * 5, State.JitterIntensity * 5)
            end
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(angle), 0)
        end
    end

    -- Kill Aura
    if State.KillAura and LocalPlayer.Character then
        local knife = LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
        if knife then
            if knife.Parent == LocalPlayer.Backpack then knife.Parent = LocalPlayer.Character end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                   and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local dist = (p.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= 15 and knife:FindFirstChild("Handle") then
                        pcall(function()
                            firetouchinterest(knife.Handle, p.Character.HumanoidRootPart, 0)
                            firetouchinterest(knife.Handle, p.Character.HumanoidRootPart, 1)
                        end)
                    end
                end
            end
        end
    end

    -- Auto Grab Gun
    if State.AutoGrabGun and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local gunDrop = workspace:FindFirstChild("GunDrop") or workspace:FindFirstChild("Gun")
        if gunDrop then
            local part = gunDrop:IsA("BasePart") and gunDrop or gunDrop:FindFirstChildWhichIsA("BasePart")
            if part then
                LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 1, 0)
            end
        end
    end

    -- Chase camera
    if State.ChaseCamera and State.ChaseTarget and State.ChaseTarget.Character then
        local hum = State.ChaseTarget.Character:FindFirstChildOfClass("Humanoid")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end

    -- Auto Collect Coins
    if State.AutoCollectCoins and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = LocalPlayer.Character.HumanoidRootPart
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "Coin" or obj.Name == "CoinContainer" then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part and (part.Position - root.Position).Magnitude < 6 then
                    root.CFrame = part.CFrame + Vector3.new(0, 2, 0)
                end
            end
        end
    end

    -- Auto Dodge Murderer
    if State.AutoDodge and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local murd = GetMurderer()
        if murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart") then
            local d = (murd.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if d < 20 then
                local dir = (LocalPlayer.Character.HumanoidRootPart.Position - murd.Character.HumanoidRootPart.Position).Unit
                LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + dir * 2
            end
        end
    end
end)
table.insert(activeCleanups, function() mainRenderConn:Disconnect() end)

-- Mobile: touch-aware screen resize
if IS_MOBILE then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if not workspace.CurrentCamera then return end
        local vs = workspace.CurrentCamera.ViewportSize
        local maxW = vs.X - 40
        local maxH = vs.Y - 80
        local s = math.min(math.min(BASE_W * 1.25, maxW) / BASE_W, math.min(BASE_H * 1.25, maxH) / BASE_H)
        MainUIScale.Scale = math.clamp(s, 0.7, 1.25)
    end)
end

SendNotify("Torium v2.1", "Loaded. Mobile: " .. (IS_MOBILE and "ON" or "OFF"))
