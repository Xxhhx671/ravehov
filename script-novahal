local EspFolder = Instance.new("Folder")
EspFolder.Name = "ToriumESP_Storage"
EspFolder.Parent = CoreGui
table.insert(activeCleanups, function() EspFolder:Destroy() end)

local ESP = {
    Boxes = {}, Names = {}, Dist = {}, Health = {}, Tracer = {}, Chams = {},
}

local ESP_COLORS = {
    Innocent = Color3.fromRGB(34, 197, 94),
    Sheriff  = Color3.fromRGB(59, 130, 246),
    Murderer = Color3.fromRGB(236, 72, 153),
}

local function GetRoleColor(plr)
    local role = GetPlayerRole(plr)
    return ESP_COLORS[role] or ESP_COLORS.Innocent, role
end

local function CreateESP(plr)
    if ESP.Names[plr] or plr == LocalPlayer then return end
    local col = GetRoleColor(plr)

    ESP.Boxes[plr] = {
        top    = Drawing.new("Line"),
        bottom = Drawing.new("Line"),
        left   = Drawing.new("Line"),
        right  = Drawing.new("Line"),
    }
    for _, l in pairs(ESP.Boxes[plr]) do
        l.Visible = false
        l.Thickness = 1.5
        l.Color = col
    end

    ESP.Names[plr] = Drawing.new("Text")
    ESP.Names[plr].Size = 13
    ESP.Names[plr].Center = true
    ESP.Names[plr].Outline = true
    ESP.Names[plr].Color = col
    ESP.Names[plr].Visible = false

    ESP.Dist[plr] = Drawing.new("Text")
    ESP.Dist[plr].Size = 12
    ESP.Dist[plr].Center = true
    ESP.Dist[plr].Outline = true
    ESP.Dist[plr].Color = Color3.fromRGB(230, 230, 230)
    ESP.Dist[plr].Visible = false

    ESP.Health[plr] = {bg = Drawing.new("Line"), fill = Drawing.new("Line")}
    ESP.Health[plr].bg.Visible = false
    ESP.Health[plr].bg.Thickness = 3
    ESP.Health[plr].bg.Color = Color3.fromRGB(30, 30, 30)
    ESP.Health[plr].fill.Visible = false
    ESP.Health[plr].fill.Thickness = 3
    ESP.Health[plr].fill.Color = Color3.fromRGB(34, 197, 94)

    ESP.Tracer[plr] = Drawing.new("Line")
    ESP.Tracer[plr].Visible = false
    ESP.Tracer[plr].Thickness = 1.2
    ESP.Tracer[plr].Color = col
end

local function RemoveESP(plr)
    if ESP.Boxes[plr]  then for _, l in pairs(ESP.Boxes[plr]) do pcall(function() l:Remove() end) end end
    if ESP.Names[plr]  then pcall(function() ESP.Names[plr]:Remove() end) end
    if ESP.Dist[plr]   then pcall(function() ESP.Dist[plr]:Remove() end) end
    if ESP.Health[plr] then
        pcall(function() ESP.Health[plr].bg:Remove() end)
        pcall(function() ESP.Health[plr].fill:Remove() end)
    end
    if ESP.Tracer[plr] then pcall(function() ESP.Tracer[plr]:Remove() end) end
    if ESP.Chams[plr]  then pcall(function() ESP.Chams[plr]:Destroy() end) end
    ESP.Boxes[plr]  = nil
    ESP.Names[plr]  = nil
    ESP.Dist[plr]   = nil
    ESP.Health[plr] = nil
    ESP.Tracer[plr] = nil
    ESP.Chams[plr]  = nil
end

local function CreateChams(plr)
    if not plr.Character or ESP.Chams[plr] then return end
    local h = Instance.new("Highlight")
    h.Name = "ToriumCham"
    h.Adornee = plr.Character
    h.FillTransparency = 0.7
    h.OutlineTransparency = 0
    h.FillColor = State.GlowColor
    h.OutlineColor = State.GlowColor
    h.Parent = EspFolder
    ESP.Chams[plr] = h
end

Players.PlayerRemoving:Connect(RemoveESP)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        CreateESP(p)
        if p.Character then CreateChams(p) end
        p.CharacterAdded:Connect(function()
            task.wait(0.5)
            RemoveESP(p)
            CreateESP(p)
            if State.GlowESP then CreateChams(p) end
        end)
    end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        RemoveESP(p)
        CreateESP(p)
        if State.GlowESP then CreateChams(p) end
    end)
end)

local espRenderConn = RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            if not ESP.Names[plr] and char then CreateESP(plr) end

            if not (char and hrp and hum and hum.Health > 0 and ESP.Names[plr]) then
                if ESP.Boxes[plr] then for _, l in pairs(ESP.Boxes[plr]) do l.Visible = false end end
                if ESP.Names[plr] then ESP.Names[plr].Visible = false end
                if ESP.Dist[plr]  then ESP.Dist[plr].Visible = false end
                if ESP.Health[plr] then ESP.Health[plr].bg.Visible = false; ESP.Health[plr].fill.Visible = false end
                if ESP.Tracer[plr] then ESP.Tracer[plr].Visible = false end
            else
                local roleCol, roleName = GetRoleColor(plr)

                if State.GlowESP and ESP.Chams[plr] then
                    ESP.Chams[plr].FillColor = State.GlowColor
                    ESP.Chams[plr].OutlineColor = State.GlowColor
                end

                local head = char:FindFirstChild("Head")
                local topWorld    = (head and head.Position + Vector3.new(0, 0.5, 0)) or (hrp.Position + Vector3.new(0, 3, 0))
                local bottomWorld = hrp.Position - Vector3.new(0, 3, 0)

                local topScreen, topOn = cam:WorldToViewportPoint(topWorld)
                local botScreen, botOn = cam:WorldToViewportPoint(bottomWorld)

                if not (topOn and botOn) then
                    if ESP.Boxes[plr] then for _, l in pairs(ESP.Boxes[plr]) do l.Visible = false end end
                    if ESP.Names[plr] then ESP.Names[plr].Visible = false end
                    if ESP.Dist[plr]  then ESP.Dist[plr].Visible = false end
                    if ESP.Health[plr] then ESP.Health[plr].bg.Visible = false; ESP.Health[plr].fill.Visible = false end
                    if ESP.Tracer[plr] then ESP.Tracer[plr].Visible = false end
                else
                    local height = math.abs(botScreen.Y - topScreen.Y)
                    local width  = height * 0.5
                    local x = topScreen.X - width / 2
                    local y = topScreen.Y

                    if State.BoxESP then
                        local b = ESP.Boxes[plr]
                        b.top.From    = Vector2.new(x, y);              b.top.To    = Vector2.new(x + width, y)
                        b.bottom.From = Vector2.new(x, y + height);     b.bottom.To = Vector2.new(x + width, y + height)
                        b.left.From   = Vector2.new(x, y);              b.left.To   = Vector2.new(x, y + height)
                        b.right.From  = Vector2.new(x + width, y);      b.right.To  = Vector2.new(x + width, y + height)
                        for _, l in pairs(b) do l.Color = roleCol; l.Visible = true end
                    else
                        for _, l in pairs(ESP.Boxes[plr]) do l.Visible = false end
                    end

                    if State.BoxESP or State.GlowESP then
                        ESP.Names[plr].Text = plr.Name .. " [" .. roleName .. "]"
                        ESP.Names[plr].Position = Vector2.new(x + width / 2, y - 16)
                        ESP.Names[plr].Color = roleCol
                        ESP.Names[plr].Visible = true
                    else
                        ESP.Names[plr].Visible = false
                    end

                    if State.DistanceESP and myRoot then
                        local dist = math.floor((hrp.Position - myRoot.Position).Magnitude)
                        ESP.Dist[plr].Text = "[" .. dist .. "m]"
                        ESP.Dist[plr].Position = Vector2.new(x + width / 2, y + height + 4)
                        ESP.Dist[plr].Visible = true
                    else
                        ESP.Dist[plr].Visible = false
                    end

                    if State.HealthBarESP then
                        local hb = ESP.Health[plr]
                        local hpct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        hb.bg.From   = Vector2.new(x - 6, y)
                        hb.bg.To     = Vector2.new(x - 6, y + height)
                        hb.fill.From = Vector2.new(x - 6, y + height * (1 - hpct))
                        hb.fill.To   = Vector2.new(x - 6, y + height)
                        hb.fill.Color = Color3.fromRGB(math.floor(255*(1-hpct)), math.floor(255*hpct), 0)
                        hb.bg.Visible   = true
                        hb.fill.Visible = true
                    else
                        ESP.Health[plr].bg.Visible = false
                        ESP.Health[plr].fill.Visible = false
                    end

                    if State.TracerMurderer and roleName == "Murderer" then
                        local t = ESP.Tracer[plr]
                        t.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                        t.To = Vector2.new(x + width / 2, y + height)
                        t.Color = roleCol
                        t.Visible = true
                    else
                        ESP.Tracer[plr].Visible = false
                    end
                end
            end
        end
    end
end)
