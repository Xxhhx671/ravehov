local ESPContainer = ESPIndicator.new({
    ArrowEdgePadding = 50,
    ArrowShowDistanceText = false,
})

local function ReloadPlayerESP()
    ESPContainer:RemoveGroup("players")
    if not (State.GlowESP or State.BoxESP or State.NameESP or State.RoleESP
         or State.HealthBarESP or State.DistanceESP or State.WeaponESP) then
        return
    end

    local murderer = GetMurderer()
    local sheriff  = GetSheriff()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local col = ROLE_COLORS.Innocent
            local roleName = "Innocent"
            local showLabel = State.RoleESP or State.NameESP
            local labelText = ""
            local showArrow = false
            local arrowSize = UDim2.new(0,30,0,30)
            local arrowMin = 0

            if plr == murderer then
                col = ROLE_COLORS.Murderer
                roleName = "Murderer"
                labelText = State.NameESP and (plr.Name .. " [Murderer]") or "Murderer"
                showArrow = true
                arrowSize = UDim2.new(0,40,0,40)
                arrowMin = 999999
            elseif plr == sheriff then
                col = ROLE_COLORS.Sheriff
                roleName = "Sheriff"
                labelText = State.NameESP and (plr.Name .. " [Sheriff]") or "Sheriff"
            else
                labelText = State.NameESP and (plr.Name .. " [Innocent]") or "Innocent"
            end

            if State.WeaponESP then
                local w = ""
                if HasTool(plr, "Knife") then w = " [Knife]"
                elseif HasTool(plr, "Gun") then w = " [Gun]" end
                labelText = labelText .. w
            end

            if State.DistanceESP and GetMyHRP() and char:FindFirstChild("HumanoidRootPart") then
                local d = math.floor((char.HumanoidRootPart.Position - GetMyHRP().Position).Magnitude)
                labelText = labelText .. " [" .. d .. "m]"
            end

            ESPContainer:Add(char, {
                AccentColor                   = col,
                HighlightFillTransparency     = State.GlowESP and 0.7 or 1,
                HighlightOutlineTransparency  = State.GlowESP and 0 or 1,
                ArrowShow                     = showArrow,
                ArrowMinDistance              = arrowMin,
                ArrowSize                     = arrowSize,
                ShowLabel                     = showLabel,
                LabelText                     = labelText,
                LabelMaxDistance              = 500,
                GroupName                     = "players",
            })
        end
    end
end

local function ReloadGunDropESP()
    ESPContainer:RemoveGroup("gun")
    if not State.GunDropESP then return end
    local map = GetMap()
    if map then
        local drop = map:FindFirstChild("GunDrop")
        if drop then
            ESPContainer:Add(drop, {
                AccentColor = Color3.fromRGB(255, 255, 0),
                ArrowShow = true,
                ArrowMinDistance = 999999,
                ArrowSize = UDim2.new(0,40,0,40),
                LabelText = "Dropped gun!",
                ShowLabel = true,
                GroupName = "gun",
            })
        end
    end
end

local function ReloadTrapESP()
    ESPContainer:RemoveGroup("trap")
    if not State.TrapESP then return end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "Trap" and v.Parent:IsA("Folder") then
            pcall(function() v.Transparency = 0 end)
            ESPContainer:Add(v, {
                AccentColor = Color3.fromRGB(255, 0, 0),
                ArrowShow = false,
                ShowLabel = true,
                LabelText = "Trap",
                GroupName = "trap",
            })
        end
    end
end

