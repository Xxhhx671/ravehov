    STEP("features-config", function()
        if not T.P_cfg then return end
        T.P_cfg:AddLabel("— CONFIG SLOTS —")
        local function HasFileAPI()
            return type(writefile)=="function" and type(readfile)=="function"
               and type(isfile)=="function" and type(isfolder)=="function" and type(makefolder)=="function"
        end
        local function EnsureFolder()
            if not HasFileAPI() then return false end
            return pcall(function() if not isfolder("Torium") then makefolder("Torium") end end)
        end
        local function UserKey() return tostring(LocalPlayer.UserId) end
        local function BuildJSON()
            local cfg = {}
            for k, v in pairs(State) do
                if typeof(v) == "Color3" then cfg[k] = {r=v.R, g=v.G, b=v.B, _c=true}
                elseif type(v)=="boolean" or type(v)=="number" or type(v)=="string" then cfg[k] = v end
            end
            return HttpService:JSONEncode(cfg)
        end
        local function ApplyJSON(js)
            local ok, cfg = pcall(function() return HttpService:JSONDecode(js) end)
            if not ok or not cfg then return false end
            for k, v in pairs(cfg) do
                if type(v)=="table" and v._c then State[k] = Color3.new(v.r,v.g,v.b)
                else State[k] = v end
            end
            return true
        end
        local function SaveConfig(slot)
            local js = BuildJSON(); local saved = false
            if HasFileAPI() and EnsureFolder() then
                saved = pcall(function() writefile("Torium/user_"..UserKey().."_slot"..slot..".json", js) end)
            end
            getgenv().ToriumConfigs = getgenv().ToriumConfigs or {}
            getgenv().ToriumConfigs[UserKey().."_"..slot] = js
            Notify("Config", "Saved slot "..slot..(saved and " (file)" or " (memory)"))
        end
        local function LoadConfig(slot)
            local js
            if HasFileAPI() then
                pcall(function()
                    local up = "Torium/user_"..UserKey().."_slot"..slot..".json"
                    if isfile(up) then js = readfile(up) end
                end)
            end
            if not js then
                getgenv().ToriumConfigs = getgenv().ToriumConfigs or {}
                js = getgenv().ToriumConfigs[UserKey().."_"..slot]
            end
            if not js then Notify("Config", "Slot "..slot.." empty"); return end
            if ApplyJSON(js) then Notify("Config", "Loaded slot "..slot)
            else Notify("Config", "Load failed") end
        end
        T.P_cfg:AddButton("Save Slot 1", function() SaveConfig(1) end)
        T.P_cfg:AddButton("Load Slot 1", function() LoadConfig(1) end)
        T.P_cfg:AddButton("Save Slot 2", function() SaveConfig(2) end)
        T.P_cfg:AddButton("Load Slot 2", function() LoadConfig(2) end)
        T.P_cfg:AddButton("Save Slot 3", function() SaveConfig(3) end)
        T.P_cfg:AddButton("Load Slot 3", function() LoadConfig(3) end)
    end)

