local function StartAutoShoot()
    if autoShootConn then autoShootConn:Disconnect() end
    autoShootConn = RunService.Heartbeat:Connect(function()
        if not State.AutoShoot then return end
        if GetPlayerRole(LocalPlayer) ~= "Sheriff" then return end
        local mc = GetMyChar()
        if not mc or not mc:FindFirstChild("HumanoidRootPart") then return end
