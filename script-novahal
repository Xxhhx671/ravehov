local function FlingPlayer(tp)
    if not tp or not tp.Character then return end
    local mc = GetMyChar()
    local hu = mc and mc:FindFirstChildOfClass("Humanoid")
    local hr = hu and hu.RootPart
    if not hr then return end
    local tc = tp.Character
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = th and th.RootPart
    local thead = tc:FindFirstChild("Head")
    if not th then return end
    local of = workspace.FallenPartsDestroyHeight
    local op = hr.CFrame
    local BV = Instance.new("BodyVelocity")
    BV.Velocity = Vector3.new(9e7, 9e7*10, 9e7)
    BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BV.Parent = hr
    hu:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    local function FP(pt, ps, an)
        hr.CFrame = CFrame.new(pt.Position) * ps * an
        pcall(function() mc:SetPrimaryPartCFrame(CFrame.new(pt.Position) * ps * an) end)
        hr.Velocity = Vector3.new(9e7, 9e7*10, 9e7)
        hr.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end
    local function SFP(pt)
        local t0 = tick()
        local an = 0
        repeat
            if not hr or not th then break end
            an = an + 100
            FP(pt, CFrame.new(0,1.5,0) + th.MoveDirection * 3, CFrame.Angles(math.rad(an),0,0))
            task.wait()
            FP(pt, CFrame.new(0,-1.5,0) + th.MoveDirection * 3, CFrame.Angles(math.rad(an),0,0))
            task.wait()
        until pt.Velocity.Magnitude > 500 or tick() > t0 + 2
    end
    workspace.FallenPartsDestroyHeight = 0/0
    if tr and thead and (tr.CFrame.p - thead.CFrame.p).Magnitude > 5 then SFP(thead)
    elseif tr then SFP(tr) end
    pcall(function() BV:Destroy() end)
    hu:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.FallenPartsDestroyHeight = of
    pcall(function()
        repeat
            hr.CFrame = op
            hu:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.wait()
        until (hr.Position - op.p).Magnitude < 25
    end)
end

local lastSafePos = nil
local antiFlingConn
local function StartAntiFling()
    if antiFlingConn then antiFlingConn:Disconnect() end
    antiFlingConn = RunService.Heartbeat:Connect(function()
        if not State.AntiFling then return end
        local mc = GetMyChar()
        local hr = mc and mc.PrimaryPart
        if not hr then return end
        if hr.AssemblyLinearVelocity.Magnitude > 250 or hr.AssemblyAngularVelocity.Magnitude > 250 then
            pcall(function()
                hr.AssemblyLinearVelocity = Vector3.zero
                hr.AssemblyAngularVelocity = Vector3.zero
                if lastSafePos then hr.CFrame = CFrame.new(lastSafePos) end
            end)
        else lastSafePos = hr.Position end
    end)
end

