                        local role = GetRole(plr)
                        local col = RoleColor(role)
                        e.hl.Adornee = c
                        if State.GlowESP or State.BoxESP then
                            e.hl.FillColor = col; e.hl.OutlineColor = col
                            e.hl.FillTransparency = State.BoxESP and 0.85 or 0.7
                            e.hl.OutlineTransparency = 0
                        else
                            e.hl.FillTransparency = 1; e.hl.OutlineTransparency = 1
                        end
                        local head = c:FindFirstChild("Head")
                        e.bb.Adornee = head or c:FindFirstChild("HumanoidRootPart")
                        if State.NameESP then
                            e.lbl.Visible = true
                            e.lbl.Text = plr.Name .. (State.RoleESP and (" ["..role.."]") or "")
                            e.lbl.TextColor3 = col
                        else
                            e.lbl.Visible = false
                        end
                        local subs = {}
                        local hrp = c:FindFirstChild("HumanoidRootPart")
                        if State.DistanceESP and myHRP and hrp then
                            local d = math.floor((hrp.Position - myHRP.Position).Magnitude)
                            table.insert(subs, d .. "m")
                        end
                        if State.WeaponESP then
                            if HasTool(plr, "Knife") then table.insert(subs, "Knife")
                            elseif HasTool(plr, "Gun") then table.insert(subs, "Gun") end
                        end
                        e.sub.Text = table.concat(subs, " · ")
                        e.sub.Visible = #subs > 0
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        if State.HealthBarESP and hum then
                            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            e.hbBg.Visible = true
                            e.hbFill.Size = UDim2.new(pct, 0, 1, 0)
                            local hcol = pct > 0.6 and Color3.fromRGB(34,197,94)
                                or pct > 0.3 and Color3.fromRGB(234,179,8)
                                or Color3.fromRGB(236,72,153)
                            e.hbFill.BackgroundColor3 = hcol
                        else
                            e.hbBg.Visible = false
                        end
                    else
                        if e then
                            e.hl.FillTransparency = 1; e.hl.OutlineTransparency = 1
                            e.lbl.Visible = false
                            e.sub.Visible = false
                            e.hbBg.Visible = false
                        end
                    end
                end
            end
        end)
    end
end)

local function RemoveDropESP()
    for k, e in pairs(DROP_OBJ) do
        pcall(function() e.hl:Destroy() end)
        pcall(function() e.bb:Destroy() end)
        DROP_OBJ[k] = nil
    end
end

local function TickDropESP()
    local seen = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        local isGunDrop = State.GunDropESP and o.Name == "GunDrop" and o:IsA("BasePart")
        local isTrap = State.TrapESP and (o.Name == "Trap" or o.Name == "BearTrap") and o:IsA("BasePart")
        if (isGunDrop or isTrap) then
            seen[o] = true
            if not DROP_OBJ[o] then
                local hl = Instance.new("Highlight")
                hl.FillColor = isGunDrop and Color3.fromRGB(59,130,246) or Color3.fromRGB(236,72,153)
                hl.OutlineColor = hl.FillColor
                hl.FillTransparency = 0.3
                hl.OutlineTransparency = 0
                hl.Adornee = o
                hl.Parent = ESP_GUI
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0,120,0,20)
                bb.StudsOffsetWorldSpace = Vector3.new(0,2,0)
                bb.AlwaysOnTop = true
                bb.Adornee = o
                bb.Parent = ESP_GUI
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1,0,1,0)
                lbl.BackgroundTransparency = 1
                lbl.Text = isGunDrop and "Gun" or "Trap"
                lbl.TextColor3 = hl.FillColor
                lbl.TextStrokeTransparency = 0
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 11
                lbl.Parent = bb
                DROP_OBJ[o] = {hl=hl, bb=bb, lbl=lbl}
            end
        end
    end
    for k, e in pairs(DROP_OBJ) do
        if not seen[k] or not k.Parent then
            pcall(function() e.hl:Destroy() end)
            pcall(function() e.bb:Destroy() end)
            DROP_OBJ[k] = nil
        end
    end
end
table.insert(activeCleanups, function() RemoveDropESP() end)
task.spawn(function() while task.wait(0.3) do
    if State.GunDropESP or State.TrapESP then TickDropESP() else RemoveDropESP() end
end end)

