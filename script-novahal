local function UpdateAntiCheatStatus()
    local _, status = DetectGame()
    local newStatus, newColor
    if status == "safe" then
        newStatus, newColor = "SAFE", Color3.fromRGB(34,197,94)
    elseif status == "unsafe" then
        newStatus, newColor = "UNSAFE", Color3.fromRGB(236,72,153)
    else
        newStatus, newColor = "NORMAL", Color3.fromRGB(234,179,8)
    end
    if newStatus ~= AntiCheat.Status then
        AntiCheat.Status = newStatus
        AntiCheat.Color = newColor
        AntiCheat.LastChange = tick()
        AntiCheat.Detections = AntiCheat.Detections + 1
        PushToast("AntiCheat Status", "Changed to " .. newStatus, newColor, 4)
    end
end

