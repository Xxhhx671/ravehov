                    PushToast("AutoGrab", "Gun grabbed", Color3.fromRGB(59,130,246), 1.5)
                    return
                end
            end
        end
    end
    task.spawn(function()
        while task.wait(0.5) do
            if State.LoopFlingMurderer then
                local m = GetMurderer()
                if m and m ~= LocalPlayer then task.spawn(CORE.FlingPlayer, m) end
            end
        end
    end)
end)

