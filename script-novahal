-- Toggle (returns frame, value getter)
local function makeToggle(parent, label, xOff, yOff, cfgTbl, cfgKey, onChange)
    local row = Instance.new("Frame", parent)
    row.Size            = UDim2.new(0, 220, 0, 36)
    row.Position        = UDim2.new(0, xOff, 0, yOff)
    row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size            = UDim2.new(1, -56, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text            = label
    lbl.TextColor3      = T.TextPrim
    lbl.Font            = Enum.Font.Gotham
    lbl.TextSize        = 13
    lbl.TextXAlignment  = Enum.TextXAlignment.Left

    local pill = Instance.new("Frame", row)
    pill.Size           = UDim2.new(0, 44, 0, 24)
    pill.Position       = UDim2.new(1, -50, 0.5, -12)
    pill.BackgroundColor3 = T.Toggle_OFF
    pill.BorderSizePixel = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", pill)
    knob.Size           = UDim2.new(0, 20, 0, 20)
    knob.Position       = UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    local function refresh()
        local on = cfgTbl[cfgKey]
        TweenService:Create(pill, TweenInfo.new(0.18), {
            BackgroundColor3 = on and T.Toggle_ON or T.Toggle_OFF
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = on and UDim2.new(0,22,0.5,-10) or UDim2.new(0,2,0.5,-10)
        }):Play()
    end
    refresh()

    local hitbox = Instance.new("TextButton", row)
    hitbox.Size         = UDim2.new(1, 0, 1, 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text         = ""
    hitbox.ZIndex       = 5
    hitbox.MouseButton1Click:Connect(function()
        cfgTbl[cfgKey] = not cfgTbl[cfgKey]
        refresh()
        if onChange then onChange(cfgTbl[cfgKey]) end
    end)

    -- question mark hint
    local hint = Instance.new("TextLabel", row)
    hint.Size           = UDim2.new(0, 16, 0, 16)
    hint.Position       = UDim2.new(1, -70, 0.5, -8)
    hint.BackgroundTransparency = 1
    hint.Text           = "?"
    hint.TextColor3     = T.TextSub
    hint.Font           = Enum.Font.GothamBold
    hint.TextSize       = 11
    hint.ZIndex         = 6

    return row
end

