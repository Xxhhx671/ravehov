local function CycColor(cur, setter, btn, label)
    local C = {
        Color3.fromRGB(236,72,153), Color3.fromRGB(59,130,246), Color3.fromRGB(34,197,94),
        Color3.fromRGB(234,179,8), Color3.fromRGB(255,255,255), Color3.fromRGB(168,85,247),
    }
    for i, c in ipairs(C) do if c == cur then cur = C[(i % #C) + 1]; break end end
    setter(cur)
    btn.Text = label .. ": RGB(" .. math.floor(cur.R*255) .. "," .. math.floor(cur.G*255) .. "," .. math.floor(cur.B*255) .. ")"
end
P_esp:AddButton("Murderer Color", function(btn) CycColor(State.ESP_Murderer_Color, function(c) State.ESP_Murderer_Color = c end, btn, "Murderer") end)
