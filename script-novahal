local function GetMyChar() return LocalPlayer.Character end
local function GetMyHRP()
    local c = GetMyChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetPredictedPosition(target, offset)
    if not target or not target.Character then return nil end
    local c = target.Character
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local ut = c:FindFirstChild("UpperTorso") or hrp
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not ut or not hum or not GetMyHRP() then return nil end
    local v = ut.AssemblyLinearVelocity
    local md = hum.MoveDirection
    local p = ut.Position + v * Vector3.new(0.75,0.5,0.75) * (offset / 15) + md * offset
    local ping = LocalPlayer:GetNetworkPing() * 1000
    local mult = (ping * ((State.OffsetPingMult - 1) * 0.01)) + 1
    return p * mult
end

