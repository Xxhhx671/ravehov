local function DoSilentAim()
    local myChar = GetMyChar()
    if not myChar then return end
    local role = GetPlayerRole(LocalPlayer)
    if role == "Sheriff" then
        local gun = myChar:FindFirstChild("Gun")
        if not gun and LocalPlayer.Backpack then
            gun = LocalPlayer.Backpack:FindFirstChild("Gun")
            if gun then myChar:FindFirstChildOfClass("Humanoid"):EquipTool(gun) end
        end
        if gun then
            local target = GetMurderer() or GetSheriffNotMe()
            if target then
                local pos = GetPredictedPosition(target, State.ShootOffset)
                if pos then
                    pcall(function()
                        gun.Shoot:FireServer(CFrame.new(myChar.RightHand.Position), CFrame.new(pos))
                    end)
                end
            end
        end
    elseif role == "Murderer" then
        local knife = myChar:FindFirstChild("Knife")
        if not knife and LocalPlayer.Backpack then
            knife = LocalPlayer.Backpack:FindFirstChild("Knife")
            if knife then myChar:FindFirstChildOfClass("Humanoid"):EquipTool(knife) end
        end
        if knife then
            local nearest, minD = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and myChar:FindFirstChild("HumanoidRootPart") then
                    local d = (p.Character.HumanoidRootPart.Position - myChar.HumanoidRootPart.Position).Magnitude
                    if d < minD then minD = d; nearest = p end
                end
            end
            if nearest then
                local pos = GetPredictedPosition(nearest, State.ShootOffset + 1)
                if pos then
                    pcall(function()
                        knife.Events.KnifeThrown:FireServer(CFrame.new(myChar.RightHand.Position), CFrame.new(pos))
                    end)
                end
            end
        end
    end
end

local function ShootMurderer()
    local myChar = GetMyChar()
    if not myChar then SendNotify("Torium", "No character."); return end
    if GetPlayerRole(LocalPlayer) ~= "Sheriff" then SendNotify("Torium", "You're not sheriff."); return end
    local gun = myChar:FindFirstChild("Gun")
