STEP("combat", function()
    CORE.DoSilentAim = function()
        local mc = GetMyChar(); if not mc then return end
        local r = GetRole(LocalPlayer)
        if r == "Murderer" then
            local k = mc:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
            if k and k.Parent == LocalPlayer.Backpack then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
            if k then
                local nr, mD = nil, math.huge
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
                        if not (State.AimbotIgnoreTeam and CORE.SameTeam(p)) then
                            local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
                            if d < mD then mD = d; nr = p end
                        end
                    end
                end
                if nr then
                    local p = CORE.PredictedPos(nr, State.ShootOffset + 1)
                    if p then CORE.ThrowKnife(k, {Position = p}) end
                end
            end
        else
            local g = CORE.EquipAnyGun()
            if g then
                local best, mD = nil, math.huge
                local mcHRP = GetMyHRP()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mcHRP then
                        if not (State.AimbotIgnoreTeam and CORE.SameTeam(p)) then
                            local d = (p.Character.HumanoidRootPart.Position - mcHRP.Position).Magnitude
                            if d < mD then mD = d; best = p end
                        end
                    end
                end
                if best then
                    local p = CORE.PredictedPos(best, State.ShootOffset)
                    if p then CORE.FireTool(g, {Position = p}) end
                end
            end
        end
    end
    CORE.ShootMurderer = function()
        local mc = GetMyChar(); if not mc then Notify("TORIUM", "No character."); return end
        local g = CORE.EquipAnyGun()
        if not g then Notify("TORIUM", "No gun."); return end
        local t = GetMurderer() or GetSheriffNotMe()
        if not t then Notify("TORIUM", "No target."); return end
        local p = CORE.PredictedPos(t, State.ShootOffset)
        if p then CORE.FireTool(g, {Position = p}) end
    end
    CORE.autoShootConn = nil
    CORE.StartAutoShoot = function()
        if CORE.autoShootConn then CORE.autoShootConn:Disconnect() end
        CORE.autoShootConn = RunService.Heartbeat:Connect(function()
            if not State.AutoShoot then return end
            local mc = GetMyChar()
            if not mc or not mc:FindFirstChild("HumanoidRootPart") then return end
            local g = CORE.EquipAnyGun()
            if not g then return end
            local t = GetMurderer() or GetSheriffNotMe()
            if not t or not t.Character then return end
            local th = t.Character:FindFirstChild("HumanoidRootPart"); if not th then return end
            if State.AimbotVisibleCheck and not State.AimbotWallbang then
                local o = mc.HumanoidRootPart.Position
                local d = (th.Position - o).Unit * 300
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {mc}
                local r = workspace:Raycast(o, d, rp)
                if r and not r.Instance:IsDescendantOf(t.Character) then return end
            end
            local p = CORE.PredictedPos(t, State.ShootOffset)
            if p then CORE.FireTool(g, {Position = p}) end
        end)
    end
    table.insert(CORE.activeCleanups, function() pcall(function() if CORE.autoShootConn then CORE.autoShootConn:Disconnect() end end) end)

    CORE.KnifeThrow = function(silent)
        local mc = GetMyChar(); if not mc then return end
        local k = mc:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
        if not k then if not silent then Notify("TORIUM", "No knife.") end; return end
        if k.Parent == LocalPlayer.Backpack then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
        local nr, mD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
                if not (State.AimbotIgnoreTeam and CORE.SameTeam(p)) then
                    local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
                    if d < mD then mD = d; nr = p end
                end
            end
        end
        if not nr then return end
        local p = CORE.PredictedPos(nr, State.ShootOffset + 1); if not p then return end
        local origin = {Position = p}
        if State.SpawnKnifeNear and nr.Character then
            local nh = nr.Character:FindFirstChild("HumanoidRootPart")
            if nh then origin = {Position = nh.Position + (nh.CFrame.LookVector * 5)} end
        end
        CORE.ThrowKnife(k, origin)
    end
    task.spawn(function()
        while task.wait(1.5) do if State.AutoKnifeThrow then pcall(CORE.KnifeThrow, true) end end
    end)

    CORE.KillEveryone = function()
        local mc = GetMyChar(); if not mc then return end
        local k = mc:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
        if not k then Notify("TORIUM", "No knife."); return end
        if k.Parent == LocalPlayer.Backpack then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
        local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
        local ac = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                if h and not h.Anchored then
                    pcall(function() h.Anchored = true; h.CFrame = mh.CFrame + mh.CFrame.LookVector * 1 end)
                    table.insert(ac, h)
                end
            end
        end
        task.wait(0.1)
        if k:FindFirstChild("Stab") then pcall(function() k.Stab:FireServer("Slash") end) end
        task.wait(0.15)
        for _, h in ipairs(ac) do pcall(function() h.Anchored = false end) end
