            TweenService:Create(to.Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
            TweenService:Create(to.SubTabs[1].Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
            to.SubTabs[1].Indicator.Visible = true
        end
    end)
    table.insert(TabsList, to)
    return to
