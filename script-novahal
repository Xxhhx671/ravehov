    Players.PlayerRemoving:Connect(CORE.RemoveESP)

    task.spawn(function()
        while task.wait(0.1) do
            pcall(function()
                local myHRP = GetMyHRP()
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        if not CORE.ESP_OBJ[plr] then CORE.CreateESP(plr) end
                        local e = CORE.ESP_OBJ[plr]
                        local c = plr.Character
                        if c and e then
                            local role = GetRole(plr)
