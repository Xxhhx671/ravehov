local function DoSilentAim()
    local mc = GetMyChar()
    if not mc then return end
    local r = GetPlayerRole(LocalPlayer)
    if r == "Sheriff" then
        local g = mc:FindFirstChild("Gun")
        if not g and LocalPlayer.Backpack then
            g = LocalPlayer.Backpack:FindFirstChild("Gun")
            if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
        end
        if g then
            local t = GetMurderer() or GetSheriffNotMe()
            if t then
                local p = GetPredictedPosition(t, State.ShootOffset)
                if p and mc:FindFirstChild("RightHand") then
                    pcall(function() g.Shoot:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                end
            end
        end
    elseif r == "Murderer" then
        local k = mc:FindFirstChild("Knife")
        if not k and LocalPlayer.Backpack then
            k = LocalPlayer.Backpack:FindFirstChild("Knife")
            if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
        end
        if k then
            local nr, mD = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
                    local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
                    if d < mD then mD = d; nr = p end
                end
            end
            if nr then
                local p = GetPredictedPosition(nr, State.ShootOffset + 1)
                if p and mc:FindFirstChild("RightHand") then
                    pcall(function() k.Events.KnifeThrown:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                end
            end
        end
    end
end

local function ShootMurderer()
    local mc = GetMyChar()
    if not mc then SendNotify("TORIUM","No character."); return end
    if GetPlayerRole(LocalPlayer) ~= "Sheriff" then SendNotify("TORIUM","Not sheriff."); return end
    local g = mc:FindFirstChild("Gun")
    if not g and LocalPlayer.Backpack then
        g = LocalPlayer.Backpack:FindFirstChild("Gun")
        if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
    end
    if not g then SendNotify("TORIUM","No gun."); return end
    local t = GetMurderer() or GetSheriffNotMe()
    if not t then SendNotify("TORIUM","No target."); return end
    local p = GetPredictedPosition(t, State.ShootOffset)
    if p and mc:FindFirstChild("RightHand") then
        pcall(function() g.Shoot:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
    end
end

local autoShootConn
local function StartAutoShoot()
    if autoShootConn then autoShootConn:Disconnect() end
    autoShootConn = RunService.Heartbeat:Connect(function()
        if not State.AutoShoot then return end
        if GetPlayerRole(LocalPlayer) ~= "Sheriff" then return end
        local mc = GetMyChar()
        if not mc or not mc:FindFirstChild("HumanoidRootPart") then return end
        local t = GetMurderer() or GetSheriffNotMe()
        if not t or not t.Character then return end
        local th = t.Character:FindFirstChild("HumanoidRootPart")
        if not th then return end
        local o = mc.HumanoidRootPart.Position
        local d = (th.Position - o).Unit * 300
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {mc}
        local r = workspace:Raycast(o, d, rp)
        if not r or r.Instance:IsDescendantOf(t.Character) then
            local g = mc:FindFirstChild("Gun")
            if not g and LocalPlayer.Backpack then
                g = LocalPlayer.Backpack:FindFirstChild("Gun")
                if g then mc:FindFirstChildOfClass("Humanoid"):EquipTool(g) end
            end
            if g then
                local p = GetPredictedPosition(t, State.ShootOffset)
                if p and mc:FindFirstChild("RightHand") then
                    pcall(function() g.Shoot:FireServer(CFrame.new(mc.RightHand.Position), CFrame.new(p)) end)
                end
            end
        end
    end)
end

local function KnifeThrow(silent)
    local mc = GetMyChar()
    if not mc then return end
    if GetPlayerRole(LocalPlayer) ~= "Murderer" then
        if not silent then SendNotify("TORIUM","Not murderer.") end
        return
    end
    local k = mc:FindFirstChild("Knife")
    if not k and LocalPlayer.Backpack then
        k = LocalPlayer.Backpack:FindFirstChild("Knife")
        if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
    end
    if not k then return end
    local nr, mD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and mc:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude
            if d < mD then mD = d; nr = p end
        end
    end
    if not nr then return end
    local p = GetPredictedPosition(nr, State.ShootOffset + 1)
    if not p then return end
    local s = CFrame.new(mc.RightHand.Position)
    if State.SpawnKnifeNear and nr.Character then
        local nh = nr.Character:FindFirstChild("HumanoidRootPart")
        if nh then s = CFrame.new(nh.Position + (nh.CFrame.LookVector * 5)) end
    end
    pcall(function() k.Events.KnifeThrown:FireServer(s, CFrame.new(p)) end)
end
task.spawn(function() while task.wait(1.5) do if State.AutoKnifeThrow then pcall(KnifeThrow, true) end end end)

local function StartKillAura()
    if not State.KillAura then return end
    local mc = GetMyChar()
    if not mc then return end
    local mh = mc:FindFirstChild("HumanoidRootPart")
    if not mh then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h and not h.Anchored and (h.Position - mh.Position).Magnitude < 7 then
                pcall(function() h.Anchored = true h.CFrame = mh.CFrame + mh.CFrame.LookVector * 2 end)
                task.wait(0.1)
                local k = mc:FindFirstChild("Knife")
                if k and k:FindFirstChild("Stab") then pcall(function() k.Stab:FireServer("Slash") end) end
                task.wait(0.15)
                pcall(function() h.Anchored = false end)
                return
            end
        end
    end
end

local function KillEveryone()
    local mc = GetMyChar()
    if not mc then return end
    if GetPlayerRole(LocalPlayer) ~= "Murderer" then SendNotify("TORIUM","Not murderer."); return end
    local k = mc:FindFirstChild("Knife")
    if not k and LocalPlayer.Backpack then
        k = LocalPlayer.Backpack:FindFirstChild("Knife")
        if k then mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end
    end
    if not k then return end
    local mh = mc:FindFirstChild("HumanoidRootPart")
    if not mh then return end
    local ac = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h and not h.Anchored then
                pcall(function() h.Anchored = true h.CFrame = mh.CFrame + mh.CFrame.LookVector * 1 end)
                table.insert(ac, h)
            end
        end
    end
    task.wait(0.1)
    pcall(function() k.Stab:FireServer("Slash") end)
    task.wait(0.15)
    for _, h in ipairs(ac) do pcall(function() h.Anchored = false end) end
    SendNotify("TORIUM","Kill everyone executed.")
end

