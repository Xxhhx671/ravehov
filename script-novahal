local function KnifeThrow(silent)
    local mc = GetMyChar(); if not mc then return end
    if GetRole(LocalPlayer) ~= "Murderer" then
        if not silent then Notify("TORIUM", "Not murderer.") end
        return
    end
    local k = mc:FindFirstChild("Knife")
