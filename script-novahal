                        t.Expanded = false
                        TweenService:Create(t.SubContainer, TWEEN, {Size = UDim2.new(1,0,0,0)}):Play()
                    end
                end
                to.Expanded = not to.Expanded
                local th = to.Expanded and (#to.SubTabs * 28) or 0
                TweenService:Create(sc, TWEEN, {Size = UDim2.new(1,0,0,th)}):Play()
