-- ── Box ESP geometry ────────────────────────────────────────
local function updateBox(player, e, color)
    local char = player.Character
    if not char then e.boxFrame.Visible = false return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then e.boxFrame.Visible = false return end

    -- 8 corners of a rough character bounding box (studs)
    local w, h = 2, 5  -- width, height
    local pos = hrp.CFrame.Position
    local pts = {
        pos + Vector3.new(-w/2, -h/2, -w/2),
        pos + Vector3.new( w/2, -h/2, -w/2),
        pos + Vector3.new(-w/2,  h/2, -w/2),
        pos + Vector3.new( w/2,  h/2, -w/2),
        pos + Vector3.new(-w/2, -h/2,  w/2),
        pos + Vector3.new( w/2, -h/2,  w/2),
        pos + Vector3.new(-w/2,  h/2,  w/2),
        pos + Vector3.new( w/2,  h/2,  w/2),
    }

    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local allVisible = true
    for _, p3 in ipairs(pts) do
        local sp, vis = camera:WorldToScreenPoint(p3)
        if not vis then allVisible = false break end
        if sp.X < minX then minX = sp.X end
        if sp.Y < minY then minY = sp.Y end
        if sp.X > maxX then maxX = sp.X end
        if sp.Y > maxY then maxY = sp.Y end
    end

    if not allVisible then e.boxFrame.Visible = false return end

    local thick = 1.5
    local vp = camera.ViewportSize
    local L = e.lines

    e.boxFrame.Visible = true
    e.boxFrame.Size    = UDim2.new(0, maxX-minX, 0, maxY-minY)
    e.boxFrame.Position = UDim2.new(0, minX, 0, minY)

    -- top
    L[1].Size     = UDim2.new(1,0,0,thick)
    L[1].Position = UDim2.new(0,0,0,0)
    L[1].BackgroundColor3 = color
    -- bottom
    L[2].Size     = UDim2.new(1,0,0,thick)
    L[2].Position = UDim2.new(0,0,1,-thick)
    L[2].BackgroundColor3 = color
    -- left
    L[3].Size     = UDim2.new(0,thick,1,0)
    L[3].Position = UDim2.new(0,0,0,0)
    L[3].BackgroundColor3 = color
    -- right
    L[4].Size     = UDim2.new(0,thick,1,0)
    L[4].Position = UDim2.new(1,-thick,0,0)
    L[4].BackgroundColor3 = color
end

