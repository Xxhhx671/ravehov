STEP("bhop", function()
    CORE.bhopConn = nil
    CORE.StartBhop = function()
        if CORE.bhopConn then CORE.bhopConn:Disconnect() end
        local jumpCooldown = 0
        CORE.bhopConn = RunService.Heartbeat:Connect(function(dt)
            if not State.Bhop then return end
            local mc = LocalPlayer.Character; if not mc then return end
            local hu = mc:FindFirstChildOfClass("Humanoid")
            local hrp = mc:FindFirstChild("HumanoidRootPart")
            if not hu or not hrp then return end

            -- держим спринт всегда
            if hu.WalkSpeed < State.BhopSpeed * 0.4 then
                hu.WalkSpeed = State.BhopSpeed * 0.4
            end

            local grounded = hu.FloorMaterial ~= Enum.Material.Air
            local holdingSpace = UserInputService:IsKeyDown(Enum.KeyCode.Space)
                or UserInputService.TouchEnabled -- на мобиле авто-прыжок

            if holdingSpace then
                if grounded and tick() - jumpCooldown > 0.05 then
                    jumpCooldown = tick()
                    hu:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                -- boost скорости в воздухе
                if State.BhopBoostAir and not grounded then
                    local move = hu.MoveDirection
                    if move.Magnitude > 0.1 then
                        local cur = hrp.AssemblyLinearVelocity
                        local target = Vector3.new(
                            move.X * State.BhopSpeed,
                            cur.Y,
                            move.Z * State.BhopSpeed
                        )
                        hrp.AssemblyLinearVelocity = cur:Lerp(target, 0.35)
                    end
                end
                -- сохраняем momentum на приземлении (не даём Roblox сбросить)
                if grounded and State.BhopBoostAir then
                    local move = hu.MoveDirection
                    if move.Magnitude > 0.1 then
                        local cur = hrp.AssemblyLinearVelocity
                        hrp.AssemblyLinearVelocity = Vector3.new(
                            move.X * State.BhopSpeed,
                            cur.Y,
                            move.Z * State.BhopSpeed
                        )
                    end
                end
            end
        end)
    end
    table.insert(CORE.activeCleanups, function() pcall(function() if CORE.bhopConn then CORE.bhopConn:Disconnect() end end) end)
end)

