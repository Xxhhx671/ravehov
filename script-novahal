    elseif UserInputService.TouchEnabled and UserInputService.MouseEnabled then p = "Tablet"
    elseif UserInputService.GamepadEnabled then p = "Console" end
    local o = "Unknown"
    pcall(function() o = tostring(UserInputService:GetPlatform()):gsub("Enum.Platform.","") end)
    return p, o
