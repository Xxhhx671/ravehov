local function GetPredictedPosition(target, offset)
    if not target or not target.Character then return nil end
    local c = target.Character
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local ut = c:FindFirstChild("UpperTorso") or hrp
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not ut or not hum or not GetMyHRP() then return nil end
    local v = ut.AssemblyLinearVelocity
    local md = hum.MoveDirection
    local p = ut.Position + v * Vector3.new(0.75,0.5,0.75) * (offset / 15) + md * offset
    local ping = LocalPlayer:GetNetworkPing() * 1000
    local mult = (ping * ((State.OffsetPingMult - 1) * 0.01)) + 1
    return p * mult
end

-- CONFIG SYSTEM (file-based + memory fallback)
local function HasFileAPI()
    return type(writefile) == "function"
       and type(readfile) == "function"
       and type(isfile) == "function"
       and type(isfolder) == "function"
       and type(makefolder) == "function"
end

local function EnsureFolder()
    if not HasFileAPI() then return false end
    local ok = pcall(function()
        if not isfolder("Torium") then makefolder("Torium") end
    end)
    return ok
end

local function GetUserKey()
    return tostring(LocalPlayer.UserId)
end

local function GetDeviceKey()
    local p = "PC"
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then p = "Mobile"
    elseif UserInputService.TouchEnabled and UserInputService.MouseEnabled then p = "Tablet" end
    return "Device_" .. p
end

local function BuildJSON()
    local cfg = {}
    for k, v in pairs(State) do
        if typeof(v) == "Color3" then
            cfg[k] = {r = v.R, g = v.G, b = v.B, _c = true}
        elseif type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
            cfg[k] = v
        end
    end
    return HttpService:JSONEncode(cfg)
end

local function ApplyJSON(js)
    local ok, cfg = pcall(function() return HttpService:JSONDecode(js) end)
    if not ok or not cfg then return false end
    for k, v in pairs(cfg) do
        if type(v) == "table" and v._c then
            State[k] = Color3.new(v.r, v.g, v.b)
        else
            State[k] = v
        end
    end
    return true
end

local function SaveConfig(slot)
    local js = BuildJSON()
    local saved = false

    if HasFileAPI() and EnsureFolder() then
        local ok1 = pcall(function()
            writefile("Torium/user_" .. GetUserKey() .. "_slot" .. slot .. ".json", js)
        end)
        local ok2 = pcall(function()
            writefile("Torium/" .. GetDeviceKey() .. "_slot" .. slot .. ".json", js)
        end)
        saved = ok1 or ok2
    end

    getgenv().ToriumConfigs = getgenv().ToriumConfigs or {}
    getgenv().ToriumConfigs[GetUserKey() .. "_" .. slot] = js

    if saved then
        SendNotify("Config", "Saved slot " .. slot .. " (file)")
    else
        SendNotify("Config", "Saved slot " .. slot .. " (memory)")
    end
end

local function LoadConfig(slot)
    local js

    if HasFileAPI() then
        pcall(function()
            local userPath = "Torium/user_" .. GetUserKey() .. "_slot" .. slot .. ".json"
            local devPath = "Torium/" .. GetDeviceKey() .. "_slot" .. slot .. ".json"
            if isfile(userPath) then
                js = readfile(userPath)
            elseif isfile(devPath) then
                js = readfile(devPath)
            end
        end)
    end

    if not js then
        getgenv().ToriumConfigs = getgenv().ToriumConfigs or {}
        js = getgenv().ToriumConfigs[GetUserKey() .. "_" .. slot]
    end

    if not js then
        SendNotify("Config", "Slot " .. slot .. " empty")
        return
    end

    if ApplyJSON(js) then
        SendNotify("Config", "Loaded slot " .. slot)
    else
        SendNotify("Config", "Load failed")
    end
end

local function DeleteConfig(slot)
    if HasFileAPI() then
        pcall(function()
            local userPath = "Torium/user_" .. GetUserKey() .. "_slot" .. slot .. ".json"
            local devPath = "Torium/" .. GetDeviceKey() .. "_slot" .. slot .. ".json"
            if isfile(userPath) then delfile(userPath) end
            if isfile(devPath) then delfile(devPath) end
        end)
    end

    getgenv().ToriumConfigs = getgenv().ToriumConfigs or {}
    getgenv().ToriumConfigs[GetUserKey() .. "_" .. slot] = nil

    SendNotify("Config", "Deleted slot " .. slot)
end

