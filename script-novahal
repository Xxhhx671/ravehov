local function DetectGame()
    local pid = game.PlaceId
    local data = GAME_DB[pid] or GAME_DB[game.GameId]
    if data then return data.name, data.status, pid end
    local ok, n = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(pid).Name end)
    return (ok and n) or "Unknown", "normal", pid
