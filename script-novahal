            sl.Size = UDim2.new(1,-26,1,0); sl.Position = UDim2.new(0,26,0,0)
            sl.BackgroundTransparency = 1; sl.Text = name; sl.TextColor3 = TEXT_SUB
            sl.Font = Enum.Font.GothamMedium; sl.TextSize = 10
            sl.TextXAlignment = Enum.TextXAlignment.Left
