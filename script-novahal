                    hr.AssemblyLinearVelocity = Vector3.zero
                    hr.AssemblyAngularVelocity = Vector3.zero
                    if CORE.lastSafe then hr.CFrame = CFrame.new(CORE.lastSafe) end
                end)
                PushToast("AntiFling", "Fling detected, reset", Color3.fromRGB(234,179,8), 2)
            else CORE.lastSafe = hr.Position end
        end)
    end
    table.insert(CORE.activeCleanups, function() pcall(function() if CORE.antiFlingConn then CORE.antiFlingConn:Disconnect() end end) end)

