pAutoFarm:AddButton("TP to Nearest Coin", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local nearest, minD = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "Coin" or obj.Name == "CoinContainer" then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local d = (part.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if d < minD then minD = d; nearest = part end
                end
            end
        end
        if nearest then
            LocalPlayer.Character.HumanoidRootPart.CFrame = nearest.CFrame + Vector3.new(0, 2, 0)
            SendNotify("Torium", "Teleported to coin!")
        else
            SendNotify("Torium", "No coins found")
        end
    end
end, "Teleport to nearest coin")
