    for _, tabData in ipairs(TabsList) do
        TweenService:Create(tabData.Btn, SMOOTH_TWEEN, {TextColor3 = TEXT_SUB}):Play()
        if tabData.IconImg then
            TweenService:Create(tabData.IconImg, SMOOTH_TWEEN, {ImageColor3 = TEXT_SUB}):Play()
        end
        for _, sub in ipairs(tabData.SubTabs) do
            sub.Page.Visible = false
            TweenService:Create(sub.Btn, SMOOTH_TWEEN, {TextColor3 = TEXT_SUB}):Play()
            if sub.IconImg then
                TweenService:Create(sub.IconImg, SMOOTH_TWEEN, {ImageColor3 = TEXT_SUB}):Play()
