                l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = TEXT_MAIN
                l.Font = Enum.Font.GothamMedium; l.TextSize = 10.5
                l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
                local vl = Instance.new("TextLabel")
                vl.Size = UDim2.new(0.3,-12,0,18); vl.Position = UDim2.new(0.7,0,0,5)
                vl.BackgroundTransparency = 1; vl.Text = tostring(v)
                vl.TextColor3 = ACCENT; vl.Font = Enum.Font.GothamBold
                vl.TextSize = 10.5; vl.TextXAlignment = Enum.TextXAlignment.Right
                vl.Parent = f
                local tr = Instance.new("Frame")
                tr.Size = UDim2.new(1,-24,0,5); tr.Position = UDim2.new(0,12,1,-14)
                tr.BackgroundColor3 = Color3.fromRGB(38,28,58); tr.BorderSizePixel = 0; tr.Parent = f
                Instance.new("UICorner", tr).CornerRadius = UDim.new(1,0)
                local fi = Instance.new("Frame")
                fi.Size = UDim2.new((v-mn)/(mx-mn),0,1,0); fi.BackgroundColor3 = ACCENT
                fi.BorderSizePixel = 0; fi.Parent = tr
                Instance.new("UICorner", fi).CornerRadius = UDim.new(1,0)
                local tg = Instance.new("TextButton")
                tg.Size = UDim2.new(1,0,1,0); tg.BackgroundTransparency = 1
                tg.Text = ""; tg.Parent = f
                local ds = false
                local function upd(i)
                    local pc = math.clamp((i.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
                    v = math.floor(mn + (mx - mn) * pc)
                    vl.Text = tostring(v); fi.Size = UDim2.new(pc,0,1,0)
                    if cb then task.spawn(cb, v) end
                end
                tg.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        Click(); ds = true; upd(i)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if ds and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then ds = false end
                end)
