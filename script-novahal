    STEP("main-render", function()
        local mainConn = RunService.RenderStepped:Connect(function()
            pcall(function()
                if not workspace.CurrentCamera then return end
                if State.Fullbright and not State.NightMode then Lighting.Ambient = Color3.fromRGB(255,255,255) end
                if State.NoFog then Lighting.FogEnd = 9e9 end
                if State.CustomFogColor and State.FogColorVal then Lighting.FogColor = State.FogColorVal end
                if State.ChaseCamera and State.ChaseTarget and State.ChaseTarget.Character then
                    local hu = State.ChaseTarget.Character:FindFirstChildOfClass("Humanoid")
                    if hu then workspace.CurrentCamera.CameraSubject = hu end
                end
                if State.SilentAim then CORE.DoSilentAim() end
                if State.KillAura then CORE.StartKillAura() end
                if State.AutoGrabGun then CORE.AutoGrabTick() end
                if State.Bhop and LocalPlayer.Character then
                    local hu = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hu and UserInputService:IsKeyDown(Enum.KeyCode.Space) and hu.FloorMaterial ~= Enum.Material.Air then
                        hu:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
                if State.AutoStrafe and LocalPlayer.Character then
                    local hu = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    local hr = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hu and hr and hu.FloorMaterial == Enum.Material.Air then
                        local move = hu.MoveDirection
                        if move.Magnitude > 0.1 then
                            hr.AssemblyLinearVelocity = Vector3.new(move.X * State.StrafeSpeed, hr.AssemblyLinearVelocity.Y, move.Z * State.StrafeSpeed)
                        end
                    end
                end
                if State.Spinbot and LocalPlayer.Character then
                    local hr = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hr then
                        local an = (tick() * State.YawSpeed * 10) % 360
                        hr.CFrame = CFrame.new(hr.Position) * CFrame.Angles(0, math.rad(an), 0)
                    end
                end
                if State.Jitter and LocalPlayer.Character then
                    local hr = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hr then
                        local j = math.rad(math.random(-State.JitterIntensity, State.JitterIntensity))
                        hr.CFrame = hr.CFrame * CFrame.Angles(0, j, 0)
                    end
                end
            end)
        end)
        table.insert(CORE.activeCleanups, function() pcall(function() mainConn:Disconnect() end) end)
    end)

