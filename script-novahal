STEP("aimbot-core", function()
    CORE.AimbotState = {Target=nil, Locked=nil, LastFire=0, LastSwitch=0, FlickOffset=Vector3.new(0,0,0)}
    CORE.GetCam = function() return workspace.CurrentCamera end
    CORE.W2S = function(pos)
        local cam = CORE.GetCam(); if not cam then return Vector2.new(0,0), false end
        local sp, on = cam:WorldToViewportPoint(pos)
        return Vector2.new(sp.X, sp.Y), on
    end
    CORE.GetHitbox = function(plr)
        if not plr or not plr.Character then return nil end
        local hb = State.AimbotHitbox
        if hb == "Head" then return plr.Character:FindFirstChild("Head") end
        if hb == "HumanoidRootPart" then return plr.Character:FindFirstChild("HumanoidRootPart") end
        return plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")
    end
    CORE.HasLOS = function(plr)
        if State.AimbotWallbang or not State.AimbotVisibleCheck then return true end
        local mc = GetMyChar(); local hrp = GetMyHRP(); local hb = CORE.GetHitbox(plr)
        if not hrp or not hb then return false end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {mc, plr.Character}
        return not workspace:Raycast(hrp.Position, hb.Position - hrp.Position, rp)
    end
    CORE.ValidTarget = function(plr)
        if plr == LocalPlayer or not plr.Character then return false end
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return CORE.GetHitbox(plr) ~= nil
    end
    CORE.MatchTarget = function(plr)
        local want = State.AimbotTarget
        if State.AimbotIgnoreTeam and CORE.SameTeam(plr) then return false end
        local myRole = GetRole(LocalPlayer)
        if want == "Murderer" then return GetRole(plr) == "Murderer" end
        if want == "Sheriff" then return GetRole(plr) == "Sheriff" end
        if want == "Innocent" then return GetRole(plr) == "Innocent" end
        if want == "Enemies" then
            if myRole == "Murderer" then return GetRole(plr) ~= "Murderer" end
            if myRole == "Sheriff" then return GetRole(plr) ~= "Sheriff" end
            return true
        end
        return true
    end
    CORE.SelectTarget = function()
        local best, bestDist = nil, math.huge
        local cam = CORE.GetCam(); if not cam then return nil end
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        for _, plr in ipairs(Players:GetPlayers()) do
            if CORE.ValidTarget(plr) and CORE.MatchTarget(plr) and CORE.HasLOS(plr) then
                local hb = CORE.GetHitbox(plr)
                local sp, on = CORE.W2S(hb.Position)
                if on then
                    local d = (sp - center).Magnitude
                    if d <= State.AimbotFOV and d < bestDist then best = plr; bestDist = d end
                end
            end
        end
        return best
    end
    CORE.PredictPos = function(plr)
        local hb = CORE.GetHitbox(plr); if not hb then return nil end
        if not State.AimbotPrediction then return hb.Position end
        local p = LocalPlayer:GetNetworkPing()
        return hb.Position + hb.AssemblyLinearVelocity * (p * 0.5)
    end
    CORE.AimCamera = function(plr)
        local cam = CORE.GetCam(); if not cam then return end
        local tp = CORE.PredictPos(plr); if not tp then return end
        if State.AimbotStyle == "LEGIT" then
            if tick() - CORE.AimbotState.LastSwitch > 0.05 then
                CORE.AimbotState.LastSwitch = tick()
                local j = State.AimbotHumanize / 100
                CORE.AimbotState.FlickOffset = Vector3.new(
                    (math.random()-0.5)*j, (math.random()-0.5)*j, (math.random()-0.5)*j)
            end
            tp = tp + CORE.AimbotState.FlickOffset
        end
        local cp = cam.CFrame.Position
        local dir = (tp - cp).Unit
        local goal = CFrame.lookAt(cp, cp + dir)
        local lerp = 1
        if State.AimbotStyle == "RAGE" then lerp = 1
        elseif State.AimbotStyle == "SNAP" then lerp = 0.35
        elseif State.AimbotStyle == "SMOOTH" then lerp = math.clamp(State.AimbotSmooth, 0.05, 1)
        elseif State.AimbotStyle == "LEGIT" then lerp = math.clamp(State.AimbotSmooth * 0.5, 0.02, 0.5) end
        if lerp >= 1 then cam.CFrame = goal
        else cam.CFrame = cam.CFrame:Lerp(goal, lerp) end
    end
    local lastHit = 0
    CORE.FireAt = function(plr)
        if not plr or not plr.Character then return end
        local role = GetRole(LocalPlayer)
        local hb = CORE.GetHitbox(plr); if not hb then return end
        local ok = false
        if role == "Murderer" then
            local mc = GetMyChar()
            local k = mc and (mc:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife")))
            if k and k.Parent == LocalPlayer.Backpack then
                pcall(function() mc:FindFirstChildOfClass("Humanoid"):EquipTool(k) end)
            end
            if k then
                local p = CORE.PredictPos(plr)
                if p then ok = CORE.ThrowKnife(k, {Position = p}) end
            end
        else
            local g = CORE.EquipAnyGun()
            if g then
                local p = CORE.PredictPos(plr)
                if p then ok = CORE.FireTool(g, {Position = p}) end
            end
        end
        if ok and State.AimbotHeadshotNotify and tick() - lastHit > 0.5 then
            lastHit = tick()
            PushToast("Hit "..State.AimbotHitbox, plr.Name.." ["..GetRole(plr).."]", Color3.fromRGB(34,197,94), 1.6)
            Hit()
        end
    end
    CORE.UpdateFOVCircle = function()
        if not State.AimbotDrawFOV or not State.Aimbot then FOVCircle.Visible = false; return end
        FOVCircle.Visible = true; FOVStroke.Color = State.AimbotFOVColor
        local cam = CORE.GetCam(); if not cam then return end
        local screenY = cam.ViewportSize.Y; local camFov = cam.FieldOfView
        local px = (math.tan(math.rad(State.AimbotFOV/2)) / math.tan(math.rad(camFov/2))) * (screenY/2)
        px = math.clamp(px, 20, screenY)
        FOVCircle.Size = UDim2.new(0, px*2, 0, px*2)
    end
    CORE.aimConn = nil
    CORE.StartAimbot = function()
        if CORE.aimConn then CORE.aimConn:Disconnect() end
        CORE.aimConn = RunService.RenderStepped:Connect(function()
            if not State.Aimbot then
                CORE.AimbotState.Locked = nil; FOVCircle.Visible = false; return
            end
            CORE.UpdateFOVCircle()
            local t = CORE.SelectTarget()
            CORE.AimbotState.Target = t
            if State.AimbotStyle == "RAGE" then
                if t then CORE.AimbotState.Locked = t end
            else
                if t then CORE.AimbotState.Locked = t
                elseif CORE.AimbotState.Locked and not CORE.ValidTarget(CORE.AimbotState.Locked) then
                    CORE.AimbotState.Locked = nil
                end
            end
            local tg = CORE.AimbotState.Locked
            if tg and CORE.ValidTarget(tg) then
                CORE.AimCamera(tg)
                if State.AimbotAutoFire then
                    local delay = State.AimbotTriggerDelay
                    if State.AimbotStyle == "RAGE" then delay = 0 end
                    if tick() - CORE.AimbotState.LastFire > delay then
                        CORE.AimbotState.LastFire = tick()
                        CORE.FireAt(tg)
                    end
                end
            end
        end)
    end
    table.insert(CORE.activeCleanups, function() pcall(function() if CORE.aimConn then CORE.aimConn:Disconnect() end end) end)
end)

