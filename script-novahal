    lb.TextColor3 = TEXT_SUB
    lb.Font = Enum.Font.GothamBold
    lb.TextSize = 11
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.Parent = b
    to.Btn = lb
    local sc = Instance.new("Frame")
    sc.Size = UDim2.new(1,0,0,0)
    sc.BackgroundTransparency = 1
    sc.ClipsDescendants = true
    sc.Parent = Sidebar
    local sl = Instance.new("UIListLayout")
    sl.SortOrder = Enum.SortOrder.LayoutOrder
    sl.Parent = sc
    to.SubContainer = sc
    to.Expanded = false
    b.MouseButton1Click:Connect(function()
        PlayClickSound()
        for _, t in ipairs(TabsList) do
            if t ~= to and t.Expanded then
                t.Expanded = false
                TweenService:Create(t.SubContainer, SMOOTH_TWEEN, {Size = UDim2.new(1,0,0,0)}):Play()
            end
        end
        to.Expanded = not to.Expanded
        local th = to.Expanded and (#to.SubTabs * 28) or 0
        TweenService:Create(sc, SMOOTH_TWEEN, {Size = UDim2.new(1,0,0,th)}):Play()
